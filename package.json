{
  "name": "oremus",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm --workspace @oremus/web run dev",
    "build": "npm --workspace @oremus/web run build",
    "lint": "npm --workspace @oremus/web run lint",
    "typecheck": "npm --workspace @oremus/web run typecheck",
    "test": "npm --workspace @oremus/web run test",
    "test:moderation-ai": "powershell -ExecutionPolicy Bypass -File scripts/test-moderation-ai.ps1",
    "seed": "docker compose run --rm --build seed",
    "seed:local": "npm --workspace @oremus/web run seed",
    "seed:photos": "npm --workspace @oremus/web run seed:photos",
    "seed:stories": "docker compose run --rm --build seed npm run seed:stories",
    "seed:stories:local": "npm --workspace @oremus/web run seed:stories",
    "seed:docker": "npm run seed",
    "data:mirror:docker": "docker compose run --rm data-mirror",
    "seed:copy-docker": "npm run data:mirror:docker",
    "db:migrate": "npm --workspace @oremus/web run migrate",
    "db:migrate:docker": "docker compose run --rm --build seed npm run migrate",
    "db:status": "npm --workspace @oremus/web run migrate:status",
    "db:setup": "npm --workspace @oremus/web run db:setup",
    "db:reset": "npm --workspace @oremus/web run db:reset --",
    "wipe:data": "npm --workspace @oremus/web run wipe:data --",
    "wipe:cache": "npm --workspace @oremus/web run wipe:cache --",
    "wipe:all": "npm --workspace @oremus/web run wipe:all --",
    "deploy:vps": "sh scripts/deploy-vps.sh"
  },
  "engines": { "node": ">=22" }
}
