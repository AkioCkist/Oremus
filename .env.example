NODE_ENV=development
WEB_PORT=3000
API_PORT=8001
MONGO_DB_NAME=oremus
MONGODB_URI=mongodb://localhost:27017/oremus
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
FASTAPI_URL=http://localhost:8001
APP_ORIGIN=http://localhost:3000,http://192.168.1.100:3000
LOG_LEVEL=info

