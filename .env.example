NODE_ENV=development
WEB_PORT=3000
API_PORT=8001
MONGO_DB_NAME=oremus
MONGODB_URI=mongodb://localhost:27017/oremus
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
FASTAPI_URL=http://localhost:8001
APP_ORIGIN=http://localhost:3000,http://192.168.1.100:3000
LOG_LEVEL=info

# Optional services: moderation (AI models, needs about 3 GB of memory), calls (LiveKit)
# COMPOSE_PROFILES=moderation,calls

# Content moderation: off | shadow | enforce | auto (the model decides alone, no waiting for staff). Run shadow first; see docs/MODERATION.md
MODERATION_MODE=off
MODERATION_URL=http://localhost:8010
MODERATION_SECRET=
MODERATION_THREADS=2
MODERATION_MEMORY=3g

# Ads. AD_TOKEN_SECRET is optional; see docs/ADS.md
AD_TOKEN_SECRET=
# Free credit button on /ads/manage. Unset: on, except in production.
# ADS_SELF_TOPUP=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=

# Voice and video calls. Leave LIVEKIT_URL empty to turn calling off; see docs/CALLS.md
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=127.0.0.1

# System monitoring in the admin panel (Admin > Monitoring); see docs/MONITORING.md
# MONITORING_ENABLED=true
MONITORING_SLOW_REQUEST_MS=1000
MONITORING_SLOW_QUERY_MS=100
MONITORING_SLOW_JOB_MS=2000
MONITORING_SLOW_OUTGOING_MS=1000
