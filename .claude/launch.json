{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oremus-web-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/server.ts"
      ],
      "cwd": "apps/web",
      "env": {
        "WEB_PORT": "3001",
        "APP_ORIGIN": "http://localhost:3001"
      },
      "port": 3001
    },
    {
      "name": "oremus-web-story",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/server.ts"
      ],
      "cwd": "apps/web",
      "env": {
        "WEB_PORT": "3002",
        "APP_ORIGIN": "http://localhost:3002"
      },
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "oremus-web-recs",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/server.ts"
      ],
      "cwd": "apps/web",
      "env": {
        "WEB_PORT": "3004",
        "APP_ORIGIN": "http://localhost:3004"
      },
      "port": 3004,
      "autoPort": false
    }
  ]
}