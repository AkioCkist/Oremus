{
  "name": "@oremus/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && npm run build:css && tsx watch src/server.ts",
    "dev:worker": "tsx watch src/media-worker.ts",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:client && npm run build:css",
    "build:client": "esbuild src/views-or-client/app.ts --bundle --minify --format=esm --outfile=public/assets/app.js",
    "build:css": "tailwindcss -i src/views-or-client/styles.css -o public/assets/styles.css --minify",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/media-worker.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/tests",
    "seed": "tsx src/scripts/seed.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:status": "tsx src/scripts/migrate.ts --status",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset": "tsx src/scripts/db-reset.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "multer": "^2.0.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "redis": "^5.1.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.29",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "postcss": "^8.5.4",
    "supertest": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^5.0.3"
  }
}
