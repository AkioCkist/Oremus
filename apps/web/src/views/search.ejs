<%- include('partials/head') %><%- include('partials/nav') %><main id="main" class="mx-auto max-w-4xl px-4 py-8 pb-24"><p class="eyebrow">Discover</p><h1 class="mt-2 text-balance text-3xl font-bold"><%= q ? `Results for “${q}”` : 'Search Oremus' %></h1><% if (!q) { %><div class="empty-state mt-6"><h2 class="font-semibold">What are you looking for?</h2><p class="mt-2 text-stone-600">Search for people, conversations, or communities.</p></div><% } else if (!results.length) { %><div class="empty-state mt-6"><h2 class="font-semibold">No results found</h2><p class="mt-2 text-stone-600">Try a different name or a broader phrase.</p></div><% } else { %><ul class="card mt-6 divide-y divide-stone-100"><% results.forEach(function(result) { %><li><a class="flex gap-4 p-4 hover:bg-stone-50" href="<%= result.url %>"><span class="avatar size-11"><%= result.kind.charAt(0).toUpperCase() %></span><span><strong class="block"><%= result.title %></strong><small class="text-stone-500"><%= result.subtitle || result.kind %></small></span></a></li><% }) %></ul><% } %></main><%- include('partials/foot') %>

