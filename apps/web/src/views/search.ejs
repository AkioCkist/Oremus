<%- include('partials/head') %><%- include('partials/nav') %>
<% const kinds = [['all', 'All', 'i-search'], ['user', 'People', 'i-users'], ['post', 'Posts', 'i-feed'], ['group', 'Groups', 'i-group']]; const link = (k) => `/search?${q ? 'q=' + encodeURIComponent(q) + '&' : ''}kind=${k}`; -%>
<main id="main" class="app-shell max-w-[39rem]" aria-live="polite">
  <header class="page-header !pb-2 sm:px-0">
    <h1 class="page-title"><%= q ? `“${q}”` : 'Search' %></h1>
    <%- include('partials/search-box', { boxId: 'search-page-input', formClass: 'mt-3', inputClass: 'h-11', panelClass: 'w-full', placeholder: 'Search people, posts, groups', value: q, keepKind: kind }) %>
    <nav class="scrollbar-none mt-3 flex gap-1.5 overflow-x-auto" aria-label="Result type">
      <% kinds.forEach(function (k) { const on = kind === k[0]; %>
      <a class="chip shrink-0 <%= on ? 'chip-active' : '' %>" href="<%= link(k[0]) %>" <%= on ? 'aria-current=page' : '' %>><%= k[1] %></a>
      <% }) %>
    </nav>
  </header>
  <section>
    <% if (ad) { %><div class="mb-3"><%- include('partials/ad-card', { item: ad }) %></div><% } %>
    <div class="space-y-0.5">
      <% if (!q) { %>
        <% if (people.length) { %>
        <div class="px-4 sm:px-0">
          <h2 class="rail-section-title pb-1 pt-3">Suggested for you</h2>
          <ul>
            <% people.forEach(function (person) { %>
            <li class="flex flex-wrap items-center gap-x-3 gap-y-1.5 py-2">
              <a href="/profile/<%= person.username %>"><%- include('partials/avatar', { person, size: 'size-11 text-sm' }) %></a>
              <div class="min-w-0 flex-1 leading-tight"><a class="block truncate text-footnote font-semibold hover:text-muted" href="/profile/<%= person.username %>"><%= person.displayName %></a><p class="truncate text-footnote text-muted"><%= (person.profile && person.profile.bio) || '@' + person.username %></p>
                </div>
              <div class="flex shrink-0 items-center gap-2 max-sm:basis-full max-sm:pl-14 [&_button]:h-7 [&_button]:px-2.5 [&_button]:text-footnote [&_svg]:hidden"><%- include('partials/friend-controls', { person, state: person.friendState, compact: true, full: false }) %><%- include('partials/follow-button', { person, following: person.isFollowing, compact: true, full: false }) %></div>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } else { %>
        <div class="empty-state"><div class="empty-icon"><svg class="icon size-7"><use href="#i-search"/></svg></div><h2 class="mt-4 text-title3 font-semibold">What are you looking for?</h2><p class="mt-1 text-muted">Search for people, posts or groups.</p></div>
        <% } %>
      <% } else if (q.length < 2) { %>
        <div class="empty-state"><h2 class="text-title3 font-semibold">Keep typing…</h2><p class="mt-1 text-muted">Enter at least 2 characters.</p></div>
      <% } else if (!results.length) { %>
        <div class="empty-state"><div class="empty-icon"><svg class="icon size-7"><use href="#i-search"/></svg></div><h2 class="mt-4 text-title3 font-semibold">We didn't find any results</h2><p class="mt-1 text-muted">Make sure everything is spelled correctly or try different keywords.</p></div>
      <% } else { %>
        <% results.forEach(function (r) { const icon = r.kind === 'user' ? 'i-user' : r.kind === 'group' ? 'i-group' : 'i-feed'; %>
        <article class="flex flex-wrap items-center gap-3 rounded-2xl px-4 py-2 transition-colors hover:bg-hover sm:px-2">
          <a class="flex min-w-0 flex-1 items-center gap-3" href="<%= r.url %>">
          <% if (r.kind === 'user') { %><%- include('partials/avatar', { person: { displayName: r.title, avatarUrl: r.image_url }, size: 'size-11 text-sm' }) %>
          <% } else if (r.image_url) { %><img class="size-11 shrink-0 rounded-[0.625rem] object-cover" src="<%= r.image_url %>" alt="">
          <% } else { %><span class="grid size-11 shrink-0 place-items-center rounded-[0.625rem] bg-field text-ink"><svg class="icon size-6"><use href="#<%= icon %>"/></svg></span><% } %>
          <span class="min-w-0 flex-1"><span class="block truncate text-subheadline font-semibold"><%= r.title %></span><span class="block truncate text-footnote text-muted"><%= r.kind === 'user' ? 'Person' : r.kind === 'group' ? 'Group' : 'Post' %><%= r.subtitle && r.subtitle !== 'Post' ? ' · ' + r.subtitle : '' %></span></span>
          <% if (r.kind !== 'user') { %><svg class="icon text-subtle"><use href="#i-chevron-right"/></svg><% } %>
          </a>
          <% if (r.kind === 'user') { %><div class="flex flex-wrap gap-2 max-sm:basis-full max-sm:pl-14 [&_button]:h-7 [&_button]:px-2.5 [&_button]:text-footnote [&_svg]:hidden"><%- include('partials/friend-controls', { person: { id: r.id, title: r.title }, state: r.friendState, compact: true, full: false }) %><%- include('partials/follow-button', { person: { id: r.id }, following: r.isFollowing, compact: true, full: false }) %></div><% } %>
        </article>
        <% }) %>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
