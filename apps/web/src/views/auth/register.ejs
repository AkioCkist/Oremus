<%- include('../partials/head') %>
<main id="main" class="grid min-h-dvh lg:grid-cols-2">
  <section class="hidden bg-accent-700 p-12 text-white lg:flex lg:flex-col lg:justify-between"><a href="/" class="text-xl font-bold">Oremus</a><div class="max-w-lg"><p class="mb-5 text-sm font-semibold uppercase">Make room for belonging</p><h1 class="text-balance text-5xl font-bold leading-tight">A social network that feels more human.</h1><p class="mt-6 text-pretty text-lg text-accent-100">Follow people you value, find your communities, and share without the noise.</p></div><p class="text-sm text-accent-100">One account. Your circle.</p></section>
  <section class="grid place-items-center p-6 py-12"><div class="w-full max-w-md"><a href="/" class="mb-8 flex items-center gap-2 text-xl font-bold text-accent-700 lg:hidden"><span class="grid size-9 place-items-center rounded-full bg-accent-600 text-white">O</span>Oremus</a><p class="eyebrow">Join Oremus</p><h1 class="mt-2 text-balance text-3xl font-bold">Create your account</h1>
  <form class="mt-8 space-y-4" data-api-form action="/auth/register" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label" for="displayName">Display name</label><input class="input mt-2 w-full" id="displayName" name="displayName" autocomplete="name" required minlength="2" maxlength="60"></div><div><label class="label" for="username">Username</label><input class="input mt-2 w-full" id="username" name="username" autocomplete="username" required pattern="[a-zA-Z0-9_]{3,24}" aria-describedby="username-help"><p id="username-help" class="helper">3–24 letters, numbers, or underscores.</p></div><div><label class="label" for="email">Email address</label><input class="input mt-2 w-full" id="email" name="email" type="email" autocomplete="email" required></div><div><label class="label" for="password">Password</label><input class="input mt-2 w-full" id="password" name="password" type="password" autocomplete="new-password" required minlength="10" aria-describedby="password-help"><p id="password-help" class="helper">At least 10 characters with upper/lowercase and a number.</p></div><p class="form-error hidden" data-form-error role="alert"></p><button class="button-primary w-full" type="submit">Create account</button></form><p class="mt-6 text-center text-sm text-stone-600">Already a member? <a class="font-semibold text-accent-700 hover:underline" href="/login">Sign in</a></p></div></section>
</main><%- include('../partials/foot') %>

