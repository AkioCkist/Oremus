<%- include('_shell-top') %>
        <h1 class="text-center font-display text-[2rem] font-extrabold leading-tight">Create an account</h1>
        <p class="mt-2 text-center text-15 text-muted">To continue, fill out your personal info</p>
        <form class="mt-8 space-y-4" data-api-form action="/auth/register" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label class="label" for="displayName">Full name <span class="text-red-600" aria-hidden="true">*</span></label><input class="input mt-1.5 w-full" id="displayName" name="displayName" autocomplete="name" placeholder="Name Surname" required minlength="2" maxlength="60"></div>
          <div><label class="label" for="username">Username <span class="text-red-600" aria-hidden="true">*</span></label><input class="input mt-1.5 w-full" id="username" name="username" autocomplete="username" placeholder="best_wizard421" required pattern="[a-zA-Z0-9_]{3,24}" aria-describedby="username-help"><p id="username-help" class="helper">3–24 letters, numbers or underscores.</p></div>
          <div><label class="label" for="email">E-mail <span class="text-red-600" aria-hidden="true">*</span></label><input class="input mt-1.5 w-full" id="email" name="email" type="email" autocomplete="email" placeholder="email@email.com" required></div>
          <div>
            <label class="label" for="password">Password <span class="text-red-600" aria-hidden="true">*</span></label>
            <div class="input-icon relative mt-1.5">
              <svg class="icon size-[1.125rem]"><use href="#i-key"/></svg>
              <input class="input w-full pr-11" id="password" name="password" type="password" autocomplete="new-password" placeholder="••••••••••" required minlength="10" aria-describedby="password-help" data-password-source>
              <button type="button" class="absolute right-1.5 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-hover" data-toggle-password="password" aria-label="Show password" aria-pressed="false"><svg class="icon size-[1.125rem]"><use href="#i-eye-off"/></svg></button>
            </div>
            <p id="password-help" class="helper">At least 10 characters with upper- and lowercase letters and a number.</p>
          </div>
          <div>
            <label class="label" for="password-repeat">Repeat password <span class="text-red-600" aria-hidden="true">*</span></label>
            <div class="input-icon relative mt-1.5">
              <svg class="icon size-[1.125rem]"><use href="#i-key"/></svg>
              <input class="input w-full pr-11" id="password-repeat" type="password" autocomplete="new-password" placeholder="••••••••••" required data-password-repeat>
              <button type="button" class="absolute right-1.5 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-hover" data-toggle-password="password-repeat" aria-label="Show password" aria-pressed="false"><svg class="icon size-[1.125rem]"><use href="#i-eye-off"/></svg></button>
            </div>
          </div>
          <p class="text-xs leading-relaxed text-muted">By clicking Sign up, you agree to our Terms and Conditions and confirm you have read our Privacy Notice.</p>
          <p class="form-error hidden" data-form-error role="alert"></p>
          <button class="btn-primary btn-lg w-full" type="submit">Sign up</button>
        </form>
        <p class="mt-6 text-center text-15 text-muted">Already have an account? <a class="font-semibold text-brand-600 hover:underline" href="/login">Log in</a></p>
<%- include('_shell-bottom', { heroTitle: 'Find your people.', heroText: 'Follow friends, join groups and share stories that disappear after 24 hours.' }) %>
