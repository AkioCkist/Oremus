<%- include('../partials/head') %>
<main id="main" class="grid min-h-dvh lg:grid-cols-2">
  <section class="hidden bg-accent-700 p-12 text-white lg:flex lg:flex-col lg:justify-between"><a href="/" class="text-xl font-bold">Oremus</a><div class="max-w-lg"><p class="mb-5 text-sm font-semibold uppercase">Your people, closer</p><h1 class="text-balance text-5xl font-bold leading-tight">Share the moments that make your circle matter.</h1><p class="mt-6 text-pretty text-lg text-accent-100">A focused social space for genuine conversation, shared interests, and lasting connections.</p></div><p class="text-sm text-accent-100">Private by design. Built for people.</p></section>
  <section class="grid place-items-center p-6"><div class="w-full max-w-md"><a href="/" class="mb-10 flex items-center gap-2 text-xl font-bold text-accent-700 lg:hidden"><span class="grid size-9 place-items-center rounded-full bg-accent-600 text-white">O</span>Oremus</a><p class="eyebrow">Welcome back</p><h1 class="mt-2 text-balance text-3xl font-bold">Sign in to your circle</h1><p class="mt-2 text-pretty text-stone-600">Pick up where the conversation left off.</p>
  <form class="mt-8 space-y-5" data-api-form action="/auth/login" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label" for="email">Email address</label><input class="input mt-2 w-full" id="email" name="email" type="email" autocomplete="email" required></div><div><div class="flex justify-between"><label class="label" for="password">Password</label><a class="text-sm font-medium text-accent-700 hover:underline" href="/reset-password">Forgot password?</a></div><input class="input mt-2 w-full" id="password" name="password" type="password" autocomplete="current-password" required></div><p class="form-error hidden" data-form-error role="alert"></p><button class="button-primary w-full" type="submit">Sign in</button></form><p class="mt-6 text-center text-sm text-stone-600">New here? <a class="font-semibold text-accent-700 hover:underline" href="/register">Create an account</a></p></div></section>
</main><%- include('../partials/foot') %>

