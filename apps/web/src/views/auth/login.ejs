<%- include('_shell-top') %>
        <h1 class="text-center font-display text-[2rem] font-extrabold leading-tight">Welcome back</h1>
        <p class="mt-2 text-center text-15 text-muted">Log in to pick up where you left off</p>
        <form class="mt-8 space-y-4" data-api-form action="/auth/login" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <label class="label" for="email">E-mail <span class="text-red-600" aria-hidden="true">*</span></label>
            <div class="input-icon mt-1.5"><svg class="icon size-[1.125rem]"><use href="#i-mail"/></svg><input class="input w-full" id="email" name="email" type="email" autocomplete="email" placeholder="email@example.com" required></div>
          </div>
          <div>
            <div class="flex items-baseline justify-between"><label class="label" for="password">Password <span class="text-red-600" aria-hidden="true">*</span></label><a class="text-[0.8125rem] font-semibold text-brand-600 hover:underline" href="/reset-password">Forgot password?</a></div>
            <div class="input-icon relative mt-1.5">
              <svg class="icon size-[1.125rem]"><use href="#i-key"/></svg>
              <input class="input w-full pr-11" id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••••" required>
              <button type="button" class="absolute right-1.5 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-hover" data-toggle-password="password" aria-label="Show password" aria-pressed="false"><svg class="icon size-[1.125rem]"><use href="#i-eye-off"/></svg></button>
            </div>
          </div>
          <label class="flex cursor-pointer items-center gap-2.5 text-sm text-ink" for="remember"><input class="check" id="remember" name="remember" type="checkbox" value="true"><span>Remember me for 30 days</span></label>
          <p class="form-error hidden" data-form-error role="alert"></p>
          <button class="btn-primary btn-lg w-full" type="submit">Log in</button>
        </form>
        <div class="my-6 flex items-center gap-3 text-xs text-muted"><span class="h-px flex-1 bg-line"></span>New to Oremus?<span class="h-px flex-1 bg-line"></span></div>
        <a class="btn-outline btn-lg w-full" href="/register">Create an account</a>
<%- include('_shell-bottom', { heroTitle: 'Your people, closer.', heroText: 'Catch up on stories, chats and groups from the people you care about.' }) %>
