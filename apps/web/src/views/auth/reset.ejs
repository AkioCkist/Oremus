<%- include('../partials/head') %><main id="main" class="grid min-h-dvh place-items-center p-6"><section class="card w-full max-w-md p-6 sm:p-8"><a href="/login" class="text-sm font-semibold text-accent-700">← Back to sign in</a><h1 class="mt-6 text-balance text-3xl font-bold">Reset your password</h1><p class="mt-2 text-pretty text-stone-600"><%= token ? 'Choose a new secure password.' : 'Enter your email and we will prepare a reset link.' %></p><form class="mt-6 space-y-4" data-api-form action="<%= token ? '/auth/password/reset-confirm' : '/auth/password/reset-request' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (token) { %><input type="hidden" name="token" value="<%= token %>"><div><label class="label" for="password">New password</label><input class="input mt-2 w-full" id="password" name="password" type="password" autocomplete="new-password" minlength="10" required></div><% } else { %><div><label class="label" for="email">Email address</label><input class="input mt-2 w-full" id="email" name="email" type="email" autocomplete="email" required></div><% } %><p class="form-error hidden" data-form-error role="alert"></p><p class="hidden rounded-md bg-accent-50 p-3 text-sm text-accent-700" data-form-success role="status"></p><button class="button-primary w-full" type="submit"><%= token ? 'Update password' : 'Request reset' %></button></form></section></main><%- include('../partials/foot') %>

