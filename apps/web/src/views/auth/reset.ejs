<%- include('_shell-top') %>
        <a href="/login" class="btn-ghost -ml-3 self-start"><svg class="icon"><use href="#i-arrow-left"/></svg>Back to log in</a>
        <h1 class="mt-4 text-center font-display text-[2rem] font-extrabold leading-tight"><%= token ? 'Choose a new password' : 'Find your account' %></h1>
        <p class="mt-2 text-center text-15 text-muted"><%= token ? 'Make it strong — you will use it to log in from now on.' : "Enter your email and we'll prepare a reset link." %></p>
        <form class="mt-8 space-y-4" data-api-form action="<%= token ? '/auth/password/reset-confirm' : '/auth/password/reset-request' %>" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (token) { %>
          <input type="hidden" name="token" value="<%= token %>">
          <div>
            <label class="label" for="password">New password</label>
            <div class="input-icon relative mt-1.5">
              <svg class="icon size-[1.125rem]"><use href="#i-key"/></svg>
              <input class="input w-full pr-11" id="password" name="password" type="password" autocomplete="new-password" minlength="10" required aria-describedby="password-help">
              <button type="button" class="absolute right-1.5 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-hover" data-toggle-password="password" aria-label="Show password" aria-pressed="false"><svg class="icon size-[1.125rem]"><use href="#i-eye-off"/></svg></button>
            </div>
            <p id="password-help" class="helper">At least 10 characters with upper- and lowercase letters and a number.</p>
          </div>
          <% } else { %>
          <div><label class="label" for="email">E-mail</label><div class="input-icon mt-1.5"><svg class="icon size-[1.125rem]"><use href="#i-mail"/></svg><input class="input w-full" id="email" name="email" type="email" autocomplete="email" placeholder="email@example.com" required></div></div>
          <% } %>
          <p class="form-error hidden" data-form-error role="alert"></p>
          <p class="form-success hidden" data-form-success role="status"></p>
          <a class="hidden text-sm font-semibold text-brand-600 hover:underline" data-development-reset-link>Continue to reset password →</a>
          <button class="btn-primary btn-lg w-full" type="submit"><%= token ? 'Update password' : 'Send reset link' %></button>
        </form>
<%- include('_shell-bottom', { heroTitle: "We've got you.", heroText: 'Reset your password and get back to your conversations in a minute.' }) %>
