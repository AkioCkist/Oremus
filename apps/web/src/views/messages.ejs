<%- include('partials/head', { bodyClass: 'overflow-hidden' }) %><%- include('partials/nav') %>
<%
  const me = String(currentUser._id);
  const otherOf = function (c) { return c.memberIds.find(function (m) { return String(m._id) !== me; }) || c.memberIds[0]; };
  const sharedLinks = messages.flatMap(function (m) { return extractLinks(m.content).map(function (url) { return { url, at: m.createdAt }; }); }).reverse().slice(0, 6);
  const gap = 20 * 60 * 1000;
-%>
<main id="main" class="mx-auto h-[calc(100dvh-3.5rem)] max-w-[100rem] pb-[3.75rem] md:p-4 md:pb-4">
  <section class="flex h-full overflow-hidden bg-surface md:rounded-2xl md:shadow-card">
    <!-- Icon rail -->
    <nav aria-label="Chat sections" class="hidden w-[4.5rem] shrink-0 flex-col items-center gap-2 border-r border-line py-4 lg:flex">
      <a href="/" class="msg-rail-link" aria-label="Back to home"><svg class="icon size-6"><use href="#i-arrow-left"/></svg></a>
      <div class="my-1 h-px w-8 bg-line"></div>
      <a href="/messages" class="msg-rail-link msg-rail-active" aria-label="Chats" aria-current="page"><svg class="icon size-6"><use href="#i-chat"/></svg></a>
      <a href="/groups" class="msg-rail-link" aria-label="Groups"><svg class="icon size-6"><use href="#i-group"/></svg></a>
      <a href="/search?kind=user" class="msg-rail-link" aria-label="Find people"><svg class="icon size-6"><use href="#i-user-plus"/></svg></a>
      <a href="/notifications" class="msg-rail-link" aria-label="Notifications"><svg class="icon size-6"><use href="#i-bell"/></svg></a>
      <a href="/stories/archive" class="msg-rail-link" aria-label="Archive"><svg class="icon size-6"><use href="#i-archive"/></svg></a>
    </nav>

    <!-- Conversation list -->
    <aside class="w-full shrink-0 flex-col border-r border-line md:w-[22rem] <%= activeConversation ? 'hidden md:flex' : 'flex' %>" aria-label="Conversations">
      <div class="px-4 pb-2 pt-4">
        <p class="font-display text-xl font-extrabold text-brand-600">Oremus</p>
        <div class="mt-1 flex items-center justify-between"><h1 class="font-display text-[2rem] font-extrabold">Chats</h1><a href="/search?kind=user" class="icon-btn-ghost text-brand-600" aria-label="New message"><svg class="icon"><use href="#i-compose"/></svg></a></div>
        <div class="relative mt-2">
          <label class="sr-only" for="chat-filter">Search in chats</label>
          <svg class="icon pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted"><use href="#i-search"/></svg>
          <input id="chat-filter" type="search" class="pill-input pl-9" placeholder="Search in chats" data-chat-filter autocomplete="off">
        </div>
      </div>
      <% if (conversations.length) { %>
      <ul class="flex-1 space-y-0.5 overflow-y-auto px-2 pb-3" data-chat-list>
        <% conversations.forEach(function (c) { const other = otherOf(c); const last = c.lastMessage; const mine = last && String(last.senderId) === me; const active = String(activeConversation) === String(c._id); %>
        <li data-chat-name="<%= other.displayName.toLowerCase() %>">
          <a class="chat-row <%= active ? 'chat-row-active' : '' %>" href="/messages/<%= c._id %>" <%= active ? 'aria-current=page' : '' %>>
            <%- include('partials/avatar', { person: other, size: 'size-14 text-lg' }) %>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-15 <%= c.unread ? 'font-bold' : 'font-medium' %>"><%= other.displayName %></span>
              <span class="flex gap-1 text-[0.8125rem] <%= c.unread ? 'font-bold text-brand-600' : 'text-muted' %>">
                <span class="truncate"><%= last ? `${mine ? 'You' : firstName(other.displayName)}: ${last.content}` : 'Say hi 👋' %></span>
                <% if (last) { %><span aria-hidden="true">·</span><span class="shrink-0 font-normal text-muted"><%= timeAgo(last.createdAt) %></span><% } %>
              </span>
            </span>
            <% if (c.unread) { %><span class="size-3 shrink-0 rounded-full bg-brand-600" aria-label="Unread"></span><% } %>
          </a>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <div class="flex-1 px-6 py-10 text-center"><div class="empty-icon"><svg class="icon size-7"><use href="#i-chat"/></svg></div><p class="mt-3 font-semibold">No chats yet</p><p class="mt-1 text-pretty text-sm text-muted">Add a friend to start a private chat.</p><a class="btn-primary mt-4" href="/search?kind=user">Find friends</a></div>
      <% } %>
    </aside>

    <!-- Active chat -->
    <section class="min-w-0 flex-1 flex-col bg-surface <%= activeConversation ? 'flex' : 'hidden md:flex' %>" data-conversation="<%= activeConversation || '' %>" aria-label="Conversation">
      <% if (activeConversation && partner) { %>
      <header class="flex h-[4.5rem] shrink-0 items-center gap-3 border-b border-line px-3 shadow-[0_1px_2px_rgba(0,0,0,0.04)] sm:px-4">
        <a class="icon-btn-ghost text-brand-600 md:hidden" href="/messages" aria-label="Back to chats"><svg class="icon"><use href="#i-arrow-left"/></svg></a>
        <a href="/profile/<%= partner.username %>" class="flex min-w-0 flex-1 items-center gap-3 rounded-lg p-1 hover:bg-hover">
          <%- include('partials/avatar', { person: partner, size: 'size-10 text-sm' }) %>
          <span class="min-w-0"><span class="block truncate text-[1.0625rem] font-bold leading-tight"><%= partner.displayName %></span><span class="block truncate text-[0.8125rem] text-muted">@<%= partner.username %></span></span>
        </a>
        <a href="/profile/<%= partner.username %>" class="icon-btn-ghost text-brand-600" aria-label="View profile"><svg class="icon"><use href="#i-user"/></svg></a>
        <button type="button" class="icon-btn-ghost text-brand-600" data-toggle-details aria-controls="chat-details" aria-expanded="true" aria-label="Conversation information"><svg class="icon"><use href="#i-info"/></svg></button>
      </header>

      <div class="flex-1 overflow-y-auto bg-canvas px-3 py-4 sm:px-4" id="message-list" aria-live="polite">
        <div class="flex flex-col items-center pb-6 pt-4 text-center">
          <%- include('partials/avatar', { person: partner, size: 'size-20 text-2xl' }) %>
          <p class="mt-2 text-lg font-bold"><%= partner.displayName %></p>
          <p class="text-[0.8125rem] text-muted">You're friends on Oremus</p>
          <a href="/profile/<%= partner.username %>" class="btn-secondary btn-sm mt-3">View profile</a>
        </div>
        <% messages.forEach(function (message, i) {
             const mine = String(message.senderId._id) === me;
             const prev = messages[i - 1], next = messages[i + 1];
             const newBlock = !prev || new Date(message.createdAt) - new Date(prev.createdAt) > gap;
             const lastOfRun = !next || String(next.senderId._id) !== String(message.senderId._id) || new Date(next.createdAt) - new Date(message.createdAt) > gap; %>
          <% if (newBlock) { %><p class="py-3 text-center text-xs font-semibold text-muted"><%= longTime(message.createdAt) %></p><% } %>
          <div class="flex items-end gap-2 <%= mine ? 'justify-end' : 'justify-start' %> <%= lastOfRun ? 'mb-2' : 'mb-0.5' %>">
            <% if (!mine) { %><span class="w-7 shrink-0"><% if (lastOfRun) { %><%- include('partials/avatar', { person: message.senderId, size: 'size-7 text-2xs' }) %><% } %></span><% } %>
            <p class="bubble <%= mine ? 'bubble-me' : 'bubble-them' %>" title="<%= clockTime(message.createdAt) %>"><%= message.content %></p>
          </div>
        <% }) %>
      </div>

      <form class="flex shrink-0 items-center gap-1 border-t border-line p-3" data-message-form action="/api/conversations/<%= activeConversation %>/messages" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="sr-only" for="message">Message <%= partner.displayName %></label>
        <div class="relative flex-1">
          <input class="pill-input pr-10" id="message" name="content" autocomplete="off" maxlength="3000" placeholder="Aa" required>
          <button type="button" class="absolute right-1 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-brand-600 hover:bg-line" data-emoji-for="#message" aria-label="Insert emoji"><svg class="icon"><use href="#i-smile"/></svg></button>
        </div>
        <button class="icon-btn-ghost text-brand-600" type="submit" aria-label="Send"><svg class="icon"><use href="#i-send"/></svg></button>
      </form>
      <% } else { %>
      <div class="grid flex-1 place-items-center p-8 text-center"><div><div class="empty-icon size-20"><svg class="icon size-9"><use href="#i-chat"/></svg></div><h2 class="mt-4 text-2xl font-bold">Your messages</h2><p class="mt-1 text-muted">Pick a chat on the left, or start a new one.</p><a class="btn-primary mt-5" href="/search?kind=user">New message</a></div></div>
      <% } %>
    </section>

    <% if (activeConversation && partner) { %>
    <!-- Chat details -->
    <aside id="chat-details" class="hidden w-[22rem] shrink-0 flex-col overflow-y-auto border-l border-line p-4 xl:flex" aria-label="Chat details" data-chat-details>
      <div class="flex items-center justify-between"><h2 class="text-xl font-bold">Chat details</h2><button type="button" class="icon-btn-ghost" data-toggle-details aria-label="Close details"><svg class="icon"><use href="#i-x"/></svg></button></div>
      <div class="mt-5 flex flex-col items-center text-center">
        <%- include('partials/avatar', { person: partner, size: 'size-20 text-2xl' }) %>
        <p class="mt-2 text-lg font-bold"><%= partner.displayName %></p>
        <p class="text-[0.8125rem] text-muted">@<%= partner.username %></p>
      </div>
      <div class="mt-4 flex justify-center gap-4">
        <a href="/profile/<%= partner.username %>" class="flex flex-col items-center gap-1 text-xs font-medium"><span class="icon-btn"><svg class="icon"><use href="#i-user"/></svg></span>Profile</a>
        <a href="/profile/<%= partner.username %>?tab=photos" class="flex flex-col items-center gap-1 text-xs font-medium"><span class="icon-btn"><svg class="icon"><use href="#i-image"/></svg></span>Photos</a>
        <a href="/stories/<%= partner.username %>" class="flex flex-col items-center gap-1 text-xs font-medium"><span class="icon-btn"><svg class="icon"><use href="#i-stories"/></svg></span>Stories</a>
      </div>
      <section class="mt-6">
        <h3 class="flex items-center justify-between text-[1.0625rem] font-bold">Shared links (<%= sharedLinks.length %>)</h3>
        <% if (sharedLinks.length) { %>
        <ul class="mt-2 space-y-1">
          <% sharedLinks.forEach(function (link) { let host = link.url; try { host = new URL(link.url).hostname.replace(/^www\./, ''); } catch (e) {} %>
          <li><a class="flex items-center gap-3 rounded-lg p-2 hover:bg-hover" href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><span class="icon-btn shrink-0 text-brand-600"><svg class="icon"><use href="#i-link"/></svg></span><span class="min-w-0"><span class="block truncate text-15 font-medium"><%= host %></span><span class="block truncate text-xs text-muted underline"><%= link.url %></span></span></a></li>
          <% }) %>
        </ul>
        <% } else { %><p class="mt-2 text-sm text-muted">Links you share in this chat will appear here.</p><% } %>
      </section>
      <section class="mt-6">
        <h3 class="text-[1.0625rem] font-bold">Conversation</h3>
        <ul class="mt-2 space-y-1 text-15">
          <li class="flex items-center gap-3 p-2"><span class="icon-btn shrink-0"><svg class="icon"><use href="#i-comment"/></svg></span><%= plural(messages.length, 'message') %></li>
          <% if (messages.length) { %><li class="flex items-center gap-3 p-2"><span class="icon-btn shrink-0"><svg class="icon"><use href="#i-calendar"/></svg></span>Since <%= new Date(messages[0].createdAt).toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' }) %></li><% } %>
        </ul>
      </section>
    </aside>
    <% } %>
  </section>
</main>
<%- include('partials/foot') %>
