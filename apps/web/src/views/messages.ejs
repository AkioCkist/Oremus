<%- include('partials/head') %><%- include('partials/nav') %><main id="main" class="mx-auto h-[calc(100dvh-4rem)] max-w-6xl p-4 pb-24 md:pb-4"><section class="card grid h-full overflow-hidden md:grid-cols-[20rem_1fr]"><aside class="border-r border-stone-200 <%= activeConversation ? 'hidden md:block' : '' %>"><div class="border-b border-stone-200 p-4"><h1 class="text-xl font-bold">Messages</h1></div><% if (conversations.length) { %><ul><% conversations.forEach(function(conversation) { const other = conversation.memberIds.find(function(m) { return String(m._id) !== String(currentUser._id) }) || conversation.memberIds[0]; %><li><a class="flex gap-3 border-b border-stone-100 p-4 hover:bg-stone-50 <%= String(activeConversation) === String(conversation._id) ? 'bg-accent-50' : '' %>" href="/messages/<%= conversation._id %>"><span class="avatar size-10"><%= other.displayName.charAt(0) %></span><span class="min-w-0"><strong class="block truncate"><%= other.displayName %></strong><small class="text-stone-500">Open conversation</small></span></a></li><% }) %></ul><% } else { %><div class="p-5 text-sm text-stone-600"><p>No conversations yet.</p><a class="mt-2 inline-block font-semibold text-accent-700" href="/search?q=people">Find someone to message</a></div><% } %></aside><section class="flex min-w-0 flex-col <%= !activeConversation ? 'hidden md:flex' : '' %>" data-conversation="<%= activeConversation || '' %>"><% if (activeConversation) { %><div class="border-b border-stone-200 p-4"><a class="mr-3 md:hidden" href="/messages" aria-label="Back to conversations">←</a><strong>Conversation</strong></div><div class="flex-1 space-y-4 overflow-y-auto p-4" id="message-list" aria-live="polite"><% messages.forEach(function(message) { const mine = String(message.senderId._id) === String(currentUser._id); %><div class="flex <%= mine ? 'justify-end' : 'justify-start' %>"><div class="max-w-[80%] rounded-xl px-4 py-2 <%= mine ? 'bg-accent-600 text-white' : 'bg-stone-100' %>"><p class="whitespace-pre-wrap text-pretty"><%= message.content %></p><small class="mt-1 block <%= mine ? 'text-accent-100' : 'text-stone-500' %>"><%= new Date(message.createdAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) %></small></div></div><% }) %></div><form class="flex gap-2 border-t border-stone-200 p-3" data-message-form action="/api/conversations/<%= activeConversation %>/messages" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="message">Write a message</label><input class="input flex-1" id="message" name="content" autocomplete="off" maxlength="3000" placeholder="Write a message" required><button class="button-primary" type="submit">Send</button></form><% } else { %><div class="grid flex-1 place-items-center p-8 text-center"><div><div class="mx-auto grid size-14 place-items-center rounded-full bg-accent-50 text-2xl text-accent-700">✉</div><h2 class="mt-4 text-xl font-semibold">Your conversations</h2><p class="mt-2 text-stone-600">Choose a conversation to start messaging.</p></div></div><% } %></section></section></main><%- include('partials/foot') %>

