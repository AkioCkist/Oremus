<%- include('partials/head') %><%- include('partials/nav') %>
<main id="main" class="app-grid mx-auto max-w-screen-2xl px-4 py-6 lg:px-6"><%- include('partials/sidebar') %><section class="min-w-0 space-y-5" aria-label="Home feed">
  <section class="card p-4"><form data-api-form data-reset data-reload action="/api/posts" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="post-content">Create a post</label><textarea class="input min-h-24 w-full resize-y" id="post-content" name="content" maxlength="5000" placeholder="What would you like to share, <%= currentUser.displayName.split(' ')[0] %>?"></textarea><div class="mt-3 flex flex-wrap items-center justify-between gap-3"><label class="button-secondary cursor-pointer"><span>Add images</span><input class="sr-only" name="images" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple></label><select class="input py-2" name="visibility" aria-label="Post visibility"><option value="public">Public</option><option value="followers">Followers</option><option value="private">Only me</option></select><button class="button-primary" type="submit">Publish</button></div><p class="form-error hidden" data-form-error role="alert"></p></form></section>
  <% if (posts.length) { posts.forEach(function(item) { %><%- include('partials/post-card', { item }) %><% }) } else { %><section class="empty-state"><h2 class="text-xl font-semibold">Your feed is ready for a first story</h2><p class="mt-2 text-stone-600">Follow someone or publish a post to start the conversation.</p><a class="button-primary mt-5 inline-flex" href="/search?q=people">Find people</a></section><% } %>
</section><aside class="hidden xl:block"><div class="sticky top-24 space-y-5"><section class="card p-5"><h2 class="font-semibold">People to discover</h2><ul class="mt-4 space-y-4"><% suggestions.forEach(function(person) { %><li class="flex items-center gap-3"><a class="avatar size-9" href="/profile/<%= person.username %>"><%= person.displayName.charAt(0) %></a><div class="min-w-0 flex-1"><a class="block truncate font-medium hover:underline" href="/profile/<%= person.username %>"><%= person.displayName %></a><p class="truncate text-sm text-stone-500">@<%= person.username %></p></div></li><% }) %></ul></section><section class="px-2 text-xs leading-5 text-stone-500"><p>Oremus · Community guidelines · Privacy</p><p class="mt-1">Feed cache: <%= cached ? 'hit' : 'fresh' %></p></section></div></aside></main><%- include('partials/foot') %>

