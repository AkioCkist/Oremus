<%- include('partials/head') %><%- include('partials/nav') %>
<main id="main" class="app-shell">
  <%- include('partials/sidebar') %>

  <section class="mx-auto w-full max-w-feed space-y-4" aria-label="Home feed">
    <%- include('partials/story-tray') %>
    <div class="px-0 sm:px-0"><%- include('partials/composer') %></div>
    <h1 class="sr-only">News feed</h1>
    <% if (posts.length) { %>
      <div class="space-y-4" data-infinite="feed" data-infinite-next="<%= next || '' %>">
        <%- include('partials/chunks/feed', { items: posts }) %>
      </div>
      <p class="<%= next ? 'hidden' : '' %> py-6 text-center text-sm text-muted" data-infinite-done="feed">You're all caught up · <a class="font-semibold text-brand-600 hover:underline" href="/groups">Discover groups</a></p>
    <% } else { %>
    <section class="empty-state">
      <div class="empty-icon"><svg class="icon size-7"><use href="#i-feed"/></svg></div>
      <h2 class="mt-4 text-xl font-bold">Your feed is waiting for its first post</h2>
      <p class="mx-auto mt-2 max-w-sm text-muted">Follow people you know or share something to get the conversation started.</p>
      <div class="mt-5 flex justify-center gap-2"><a class="btn-primary" href="/search?kind=user">Find friends</a><button class="btn-secondary" type="button" data-open-composer>Create post</button></div>
    </section>
    <% } %>
  </section>

  <aside class="hidden xl:block" aria-label="Contacts and suggestions">
    <div class="rail-sticky space-y-1 pr-2">
      <% if (suggestions.length) { %>
      <section class="pb-2" data-suggestions>
        <div class="flex items-center justify-between px-2 pb-1 pt-1"><h2 class="font-display text-[1.0625rem] font-bold text-muted">People you may know</h2><a class="rounded-md px-1.5 py-0.5 text-15 text-brand-600 hover:bg-rail-hover" href="/search?kind=user">See all</a></div>
        <ul class="space-y-0.5">
          <% suggestions.forEach(function (person) { %>
          <li class="group/suggestion relative flex gap-3 rounded-xl p-2 transition-colors hover:bg-rail-hover" data-suggestion="<%= person._id %>">
            <a href="/profile/<%= person.username %>" class="shrink-0" tabindex="-1" aria-hidden="true"><%- include('partials/avatar', { person, size: 'size-12 text-base' }) %></a>
            <div class="min-w-0 flex-1">
              <a href="/profile/<%= person.username %>" class="block truncate pr-6 text-15 font-semibold leading-tight hover:underline"><%= person.displayName %></a>
              <p class="mt-0.5 truncate text-[0.8125rem] text-muted">
                <% if (person.mutualFriends) { %><svg class="icon -mt-0.5 mr-0.5 inline size-3.5"><use href="#i-users"/></svg><%= plural(person.mutualFriends, 'mutual friend') %><% } else { %>@<%= person.username %><% } %>
              </p>
              <%# Buttons share one row; icons are hidden here so both labels fit the narrow rail. -%>
              <div class="mt-2 grid grid-cols-2 gap-1.5 [&_button>svg]:hidden [&_button]:px-2 [&_button]:text-[0.8125rem] [&_summary>svg]:hidden [&_summary]:px-2 [&_summary]:text-[0.8125rem]">
                <%- include('partials/friend-controls', { person, state: person.friendState, compact: true, full: true, soft: true }) %>
                <%- include('partials/follow-button', { person, following: person.isFollowing, compact: true, full: true }) %>
              </div>
            </div>
            <button type="button" class="absolute right-1.5 top-1.5 grid size-7 place-items-center rounded-full text-muted transition-opacity hover:bg-control focus-visible:opacity-100 group-hover/suggestion:opacity-100 xl:opacity-0" data-dismiss-suggestion="<%= person._id %>" aria-label="Remove <%= person.displayName %> from suggestions" title="Remove"><svg class="icon size-4"><use href="#i-x"/></svg></button>
          </li>
          <% }) %>
        </ul>
      </section>
      <div class="divider mx-2" data-suggestions-divider></div>
      <% } %>

      <% if (groups.length) { %>
      <section class="pb-2">
        <h2 class="px-2 pb-1 pt-2 font-display text-[1.0625rem] font-bold text-muted">Group chats</h2>
        <ul>
          <% groups.slice(0, 5).forEach(function (g) { %>
          <li><a class="rail-link hover:bg-rail-hover" href="/groups/<%= g.slug %>">
            <span class="grid size-9 shrink-0 place-items-center overflow-hidden rounded-full <%= g.coverUrl ? 'bg-field' : toneOf(g.name) %>"><% if (g.coverUrl) { %><img class="size-full object-cover" src="<%= g.coverUrl %>" alt=""><% } else { %><span class="font-display text-sm font-bold text-white"><%= initials(g.name) %></span><% } %></span>
            <span class="truncate"><%= g.name %></span>
          </a></li>
          <% }) %>
        </ul>
      </section>
      <div class="divider mx-2"></div>
      <% } %>

      <section>
        <div class="flex items-center justify-between px-2 pb-1 pt-2"><h2 class="font-display text-[1.0625rem] font-bold text-muted">Contacts</h2><a href="/messages" class="icon-btn-ghost" aria-label="Open chats"><svg class="icon"><use href="#i-search"/></svg></a></div>
        <% if (contacts.length) { %>
        <ul>
          <% contacts.forEach(function (person) { %>
          <li><button type="button" class="rail-link w-full hover:bg-rail-hover" data-message-user="<%= person._id %>" aria-label="Message <%= person.displayName %>">
            <%- include('partials/avatar', { person, size: 'size-9 text-xs' }) %><span class="truncate"><%= person.displayName %></span>
          </button></li>
          <% }) %>
        </ul>
        <% } else { %><p class="px-2 py-2 text-sm text-muted">People you follow will show up here so you can message them quickly.</p><% } %>
      </section>
    </div>
  </aside>
</main>
<%- include('partials/foot') %>
