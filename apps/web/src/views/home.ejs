<%- include('partials/head') %><%- include('partials/nav') %>
<main id="main" class="home-layout">

  <section class="home-feed" aria-label="Home feed">
    <%- include('partials/story-tray', { suggestedStories: locals.suggestedStories || [] }) %>
    <% if (posts.length) { %>
      <div data-infinite="feed" data-infinite-next="<%= next || '' %>">
        <%- include('partials/chunks/feed', { items: posts.slice(0, 2) }) %>
        <%- include('partials/suggested-posts', { posts: locals.suggestedPosts }) %>
        <%- include('partials/chunks/feed', { items: posts.slice(2) }) %>
      </div>
      <p class="<%= next ? 'hidden' : '' %> py-8 text-center text-footnote text-muted" data-infinite-done="feed">You're all caught up · <a class="font-semibold text-brand-600 hover:underline" href="/groups">Discover groups</a></p>
    <% } else { %>
    <section class="empty-state">
      <div class="empty-icon"><svg class="icon size-7"><use href="#i-image"/></svg></div>
      <h2 class="mt-4 text-title3 font-semibold">Your feed is waiting for its first post</h2>
      <p class="mx-auto mt-2 max-w-sm text-subheadline text-muted">Follow people you know or share something to get the conversation started.</p>
      <div class="mt-5 flex justify-center gap-2"><a class="btn-primary" href="/search?kind=user">Find friends</a><button class="btn-secondary" type="button" data-open-composer>Create post</button></div>
    </section>
    <%- include('partials/suggested-posts', { posts: locals.suggestedPosts }) %>
    <% } %>
  </section>

  <aside class="home-rail" aria-label="Suggestions">
    <a class="rail-row" href="/profile/<%= currentUser.username %>">
      <%- include('partials/avatar', { person: currentUser, size: 'size-11 text-sm' }) %>
      <span class="min-w-0 flex-1 leading-tight"><span class="block truncate text-footnote font-semibold"><%= currentUser.username %></span><span class="block truncate text-footnote text-muted"><%= currentUser.displayName %></span></span>
    </a>

    <% if (suggestions.length) { %>
    <section data-suggestions>
      <div class="rail-section-head"><h2 class="rail-section-title">Suggested for you</h2><a class="text-caption1 font-semibold text-ink hover:text-muted" href="/discover#people">See all</a></div>
      <ul>
        <% suggestions.slice(0, 5).forEach(function (person) { %>
        <li class="rail-row group/suggestion" data-suggestion="<%= person._id %>">
          <a href="/profile/<%= person.username %>" class="shrink-0" tabindex="-1" aria-hidden="true"><%- include('partials/avatar', { person, size: 'size-11 text-sm' }) %></a>
          <div class="min-w-0 flex-1 leading-tight">
            <a href="/profile/<%= person.username %>" class="block truncate text-footnote font-semibold hover:text-muted"><%= person.displayName %></a>
            <p class="truncate text-caption1 text-muted" title="<%= person.reason ? person.reason.text : '' %>"><% if (person.reason) { %><%= person.reason.text %><% } else if (person.mutualFriends) { %><%= plural(person.mutualFriends, 'mutual friend') %><% } else { %>@<%= person.username %><% } %></p>
          </div>
          <button type="button" class="btn-text" data-follow="<%= person._id %>" data-following="<%= person.isFollowing %>"><%= person.isFollowing ? 'Following' : 'Follow' %></button>
          <button type="button" class="grid size-6 place-items-center rounded-full text-subtle opacity-0 transition-opacity hover:text-ink focus-visible:opacity-100 group-hover/suggestion:opacity-100" data-dismiss-suggestion="<%= person._id %>" aria-label="Remove <%= person.displayName %> from suggestions" title="Remove"><svg class="icon size-3.5"><use href="#i-x"/></svg></button>
        </li>
        <% }) %>
      </ul>
    </section>
    <div class="hidden" data-suggestions-divider></div>
    <% } %>

    <% if (locals.suggestedGroups && suggestedGroups.length) { %>
    <section data-suggested-groups>
      <div class="rail-section-head"><h2 class="rail-section-title">Groups for you</h2><a class="text-caption1 font-semibold text-ink hover:text-muted" href="/discover#groups">See all</a></div>
      <ul>
        <% suggestedGroups.slice(0, 3).forEach(function (g) { %>
        <li class="rail-row">
          <a href="/groups/<%= g.slug %>" class="shrink-0" tabindex="-1" aria-hidden="true"><span class="grid size-11 place-items-center overflow-hidden rounded-[0.625rem] <%= g.coverUrl ? 'bg-field' : toneOf(g.name) %>"><% if (g.coverUrl) { %><img class="size-full object-cover" src="<%= g.coverUrl %>" alt="" loading="lazy"><% } else { %><span class="text-xs font-bold text-white"><%= initials(g.name) %></span><% } %></span></a>
          <div class="min-w-0 flex-1 leading-tight">
            <a href="/groups/<%= g.slug %>" class="block truncate text-footnote font-semibold hover:text-muted"><%= g.name %></a>
            <p class="truncate text-caption1 text-muted" title="<%= g.reason.text %>"><%= g.reason.text %></p>
          </div>
          <% if (g.pending) { %><span class="text-footnote text-muted">Requested</span>
          <% } else if (g.privacy === 'private') { %><a class="btn-text" href="/groups/<%= g.slug %>">Request</a>
          <% } else { %><button type="button" class="btn-text" data-group-join="<%= g._id %>">Join</button><% } %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <p class="mt-8 text-caption2 text-subtle">Oremus © <%= new Date().getFullYear() %></p>
  </aside>
</main>
<%- include('partials/foot') %>
