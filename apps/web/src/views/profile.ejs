<%- include('partials/head') %><%- include('partials/nav') %>
<% const isSelf = currentUser && String(profile._id) === String(currentUser._id); const info = profile.profile || {}; const tabHref = (t) => `/profile/${profile.username}?tab=${t}`; -%>
<% if (profile.blockedByMe) { %>
<main id="main" class="mx-auto max-w-feed px-4 py-12">
  <section class="p-8 text-center">
    <div class="empty-icon"><svg class="icon size-7"><use href="#i-lock"/></svg></div>
    <h1 class="mt-4 text-balance text-2xl font-bold">You blocked <%= profile.displayName %></h1>
    <p class="mt-2 text-pretty text-muted">You can't see each other's profiles, follow, add as a friend or send messages. Unblocking won't automatically restore your friendship or follows.</p>
    <button type="button" class="btn-primary mt-5" data-block-user="<%= profile._id %>" data-unblock="true" data-user-name="<%= profile.displayName %>">Unblock</button>
  </section>
</main>
<% } else { %>
<main id="main" class="wide-shell">
  <!-- Hero: who this is, in one centered block. -->
  <header class="mx-auto flex max-w-xl flex-col items-center px-4 pb-6 pt-5 text-center lg:pt-10">
    <% if (hasStory) { %><a href="/stories/<%= profile.username %>" aria-label="View <%= profile.displayName %>'s story" class="block press-lift"><%- include('partials/avatar', { person: profile, size: 'size-28 text-4xl md:size-36 md:text-5xl', ring: 'unseen' }) %></a>
    <% } else if (isSelf) { %><button type="button" class="block rounded-full press-lift" data-photo-menu="avatar" data-url="<%= info.avatarUrl || '' %>" aria-label="Profile picture options"><%- include('partials/avatar', { person: profile, size: 'size-28 text-4xl md:size-36 md:text-5xl' }) %></button>
    <% } else if (info.avatarUrl) { %><button type="button" class="block rounded-full press-lift" data-lightbox="<%= info.avatarUrl %>" aria-label="View profile picture"><%- include('partials/avatar', { person: profile, size: 'size-28 text-4xl md:size-36 md:text-5xl' }) %></button>
    <% } else { %><%- include('partials/avatar', { person: profile, size: 'size-28 text-4xl md:size-36 md:text-5xl' }) %><% } %>

    <h1 class="page-title mt-4 text-balance"><%= profile.displayName %></h1>
    <p class="text-subheadline text-muted">@<%= profile.username %></p>

    <p class="mt-3 flex flex-wrap justify-center gap-x-5 gap-y-1 text-subheadline">
      <span data-profile-friends><%= plural(profile.friends, 'friend') %></span>
      <span data-profile-followers data-count="<%= profile.followers %>"><%= plural(profile.followers, 'follower') %></span>
      <span><%= compact(profile.following) %> following</span>
    </p>

    <% if (info.bio && profile.canViewDetails) { %><p class="mt-3 whitespace-pre-wrap break-words text-subheadline"><%= info.bio %></p><% } %>
    <% if (info.website && profile.canViewDetails) { %><a class="mt-1 block max-w-full truncate text-subheadline font-semibold text-brand-600 hover:underline" href="<%= info.website %>" target="_blank" rel="noopener noreferrer"><%= info.website.replace(/^https?:\/\/(www\.)?/, '') %></a><% } %>
    <% if (friendsPreview.length) { %>
    <div class="mt-3 flex max-w-full items-center gap-2">
      <span class="flex -space-x-1.5"><% friendsPreview.slice(0, 3).forEach(function (p) { %><a href="/profile/<%= p.username %>" title="<%= p.displayName %>"><%- include('partials/avatar', { person: p, size: 'size-5 text-[0.5rem] ring-2 ring-canvas' }) %></a><% }) %></span>
      <span class="min-w-0 truncate text-footnote text-muted">Friends with <%= friendsPreview.slice(0, 2).map(function (p) { return firstName(p.displayName); }).join(', ') %><%= profile.friends > 2 ? ` and ${compact(profile.friends - 2)} more` : '' %></span>
    </div>
    <% } %>
    <p class="mt-2 hidden text-sm text-ios-red" role="alert" data-profile-action-error></p>
    <div class="profile-actions mt-5 flex flex-wrap items-center justify-center gap-2">
      <%- include('partials/profile-actions', { isSelf }) %>
    </div>
  </header>

  <nav aria-label="Profile sections" class="segmented">
    <a class="tab <%= tab === 'media' ? 'tab-active' : '' %>" href="<%= tabHref('media') %>" <%= tab === 'media' ? 'aria-current=page' : '' %>><svg class="icon size-[1.125rem]"><use href="#i-grid"/></svg>Media</a>
    <a class="tab <%= tab === 'posts' ? 'tab-active' : '' %>" href="<%= tabHref('posts') %>" <%= tab === 'posts' ? 'aria-current=page' : '' %>><svg class="icon size-[1.125rem]"><use href="#i-feed"/></svg>Posts</a>
    <a class="tab <%= tab === 'about' ? 'tab-active' : '' %>" href="<%= tabHref('about') %>" <%= tab === 'about' ? 'aria-current=page' : '' %>><svg class="icon size-[1.125rem]"><use href="#i-info"/></svg>About</a>
  </nav>

  <% if (tab === 'about') { %>
  <div class="mt-4 grid gap-4 px-0 sm:px-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:px-0">
    <%- include('partials/profile-about', { info, isSelf }) %>
  </div>
  <% } else if (tab === 'posts') { %>
  <section class="mx-auto mt-2 max-w-feed" aria-label="Posts">
    <% if (profileQuery) { %><div class="post-pad flex items-center justify-between gap-3 py-2"><h2 class="truncate text-subheadline font-semibold">Results for “<%= profileQuery %>”</h2><a class="btn-ghost btn-sm" href="<%= tabHref('posts') %>">Clear search</a></div><% } %>
    <% if (posts.length) { %><div data-infinite="profile-posts" data-infinite-next="<%= postsNext || '' %>" data-infinite-query="user=<%= encodeURIComponent(profile.username) %>&q=<%= encodeURIComponent(profileQuery) %>"><%- include('partials/chunks/profile-posts', { items: posts }) %></div><% } else { %>
    <div class="empty-state"><div class="empty-icon"><svg class="icon size-7"><use href="#i-feed"/></svg></div><h3 class="mt-4 text-balance text-title3 font-semibold"><%= profileQuery ? 'No matching posts' : 'No posts yet' %></h3><p class="mt-1 text-pretty text-subheadline text-muted"><%= profileQuery ? 'Try another keyword to search this profile.' : isSelf ? 'Share your first post — it will show up here.' : `When ${firstName(profile.displayName)} shares something, it will appear here.` %></p></div>
    <% } %>
  </section>
  <% } else { %>
  <% const mediaHref = (type, sort) => `/profile/${profile.username}?tab=media${type !== 'all' ? '&type=' + type : ''}${sort !== 'newest' ? '&sort=' + sort : ''}`; -%>
  <section aria-label="Media">
    <div class="flex flex-wrap items-center justify-between gap-2 px-3 pb-3 pt-4 lg:px-0">
      <nav aria-label="Media type" class="flex flex-wrap gap-1.5">
        <% [['all', 'All', mediaCounts.all], ['photos', 'Photos', mediaCounts.photos], ['videos', 'Videos', mediaCounts.videos]].forEach(function ([value, text, count]) { %>
        <a class="chip h-7 px-3 text-footnote <%= mediaFilter.type === value ? 'chip-active' : '' %>" href="<%= mediaHref(value, mediaFilter.sort) %>" <%= mediaFilter.type === value ? 'aria-current=page' : '' %>><%= text %> <span class="opacity-60"><%= compact(count) %></span></a>
        <% }) %>
      </nav>
      <form method="get" action="/profile/<%= profile.username %>">
        <input type="hidden" name="tab" value="media">
        <% if (mediaFilter.type !== 'all') { %><input type="hidden" name="type" value="<%= mediaFilter.type %>"><% } %>
        <label class="sr-only" for="media-sort">Sort by</label>
        <select id="media-sort" name="sort" class="input h-7 rounded-full py-0 pl-3 text-footnote" data-autosubmit>
          <% [['newest', 'Newest first'], ['oldest', 'Oldest first'], ['reactions', 'Most reactions'], ['comments', 'Most comments']].forEach(function ([value, text]) { %><option value="<%= value %>" <%= mediaFilter.sort === value ? 'selected' : '' %>><%= text %></option><% }) %>
        </select>
        <noscript><button type="submit" class="btn-secondary btn-sm">Apply</button></noscript>
      </form>
    </div>
    <% if (photos.length) { %>
    <div class="tile-grid" data-infinite="profile-media" data-infinite-next="<%= photosNext || '' %>" data-infinite-query="user=<%= encodeURIComponent(profile.username) %>&type=<%= mediaFilter.type %>&sort=<%= mediaFilter.sort %>" data-infinite-prefetch="10">
      <%- include('partials/chunks/profile-media', { items: photos, isSelf }) %>
    </div>
    <% } else { %>
    <div class="empty-state"><div class="empty-icon"><svg class="icon size-7"><use href="#<%= mediaFilter.type === 'videos' ? 'i-play' : 'i-camera' %>"/></svg></div><h3 class="mt-4 text-title3 font-semibold"><%= mediaFilter.type === 'videos' ? 'No videos yet' : mediaFilter.type === 'photos' ? 'No photos yet' : 'No photos or videos yet' %></h3><% if (isSelf) { %><button type="button" class="btn-text mt-2 text-subheadline" data-open-composer>Share your first photo</button><% } %></div>
    <% } %>
  </section>
  <% } %>
</main>
<dialog id="profile-search-dialog" class="w-[min(30rem,calc(100%-2rem))] rounded-sheet p-0 shadow-pop" aria-labelledby="profile-search-title">
  <div class="flex items-center justify-between border-b border-line px-4 py-3"><h2 id="profile-search-title" class="text-balance text-xl font-bold">Search this profile</h2><button type="button" class="icon-btn" data-close-dialog="profile-search-dialog" aria-label="Close search"><svg class="icon"><use href="#i-x"/></svg></button></div>
  <form action="/profile/<%= profile.username %>" method="get" class="space-y-4 p-4">
    <label class="label" for="profile-search-query">Posts by <%= profile.displayName %></label>
    <input id="profile-search-query" name="q" type="search" class="pill-input" placeholder="Search posts" value="<%= profileQuery %>" maxlength="80" required>
    <div class="flex justify-end"><button type="submit" class="btn-primary">Search</button></div>
  </form>
</dialog>
<% } %>
<%- include('partials/foot') %>
