<%- include('partials/head') %><%- include('partials/nav') %>
<main id="main" class="mx-auto max-w-5xl px-4 pb-24 sm:py-6">
  <section class="card overflow-hidden"><div class="h-44 bg-stone-200 sm:h-64"><% if (profile.profile?.coverUrl) { %><img class="size-full object-cover" src="<%= profile.profile.coverUrl %>" alt="<%= profile.displayName %>'s cover image"><% } %></div><div class="px-5 pb-6"><div class="-mt-12 flex flex-col gap-4 sm:-mt-16 sm:flex-row sm:items-end"><div class="avatar size-24 border-4 border-white text-3xl sm:size-32"><% if (profile.profile?.avatarUrl) { %><img src="<%= profile.profile.avatarUrl %>" alt=""><% } else { %><%= profile.displayName.charAt(0) %><% } %></div><div class="min-w-0 flex-1 sm:pb-2"><h1 class="text-balance text-2xl font-bold"><%= profile.displayName %></h1><p class="text-stone-500">@<%= profile.username %> · <%= profile.followers %> followers · <%= profile.following %> following</p></div><% if (currentUser && String(profile._id) !== String(currentUser._id)) { %><div class="flex gap-2"><button class="button-secondary" data-message-user="<%= profile._id %>">Message</button><button class="button-primary" data-follow="<%= profile._id %>"><%= profile.isFollowing ? 'Following' : 'Follow' %></button></div><% } else if (currentUser) { %><a class="button-secondary" href="/settings">Edit profile</a><% } %></div><% if (profile.profile?.bio) { %><p class="mt-5 max-w-2xl text-pretty"><%= profile.profile.bio %></p><% } %><div class="mt-3 flex flex-wrap gap-4 text-sm text-stone-500"><% if (profile.profile?.location) { %><span>⌖ <%= profile.profile.location %></span><% } %><% if (profile.profile?.website) { %><a class="text-accent-700 hover:underline" href="<%= profile.profile.website %>" rel="noopener noreferrer">Website</a><% } %></div></div></section>
  <section class="mx-auto mt-6 max-w-2xl space-y-5"><h2 class="text-xl font-semibold">Posts</h2><% if (posts.length) { posts.forEach(function(item) { %><%- include('partials/post-card', { item }) %><% }) } else { %><div class="empty-state"><h3 class="font-semibold">No posts yet</h3><p class="mt-2 text-stone-600">When <%= profile.displayName %> shares something, it will appear here.</p></div><% } %></section>
</main><%- include('partials/foot') %>

