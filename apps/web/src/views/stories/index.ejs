<%- include('../partials/head', { bodyClass: 'overflow-hidden bg-surface' }) %>
<% const mine = tray.find(function (g) { return g.isSelf; }); const storyAudience = (currentUser.profile && currentUser.profile.storyAudience) || 'followers'; -%>
<main id="main" class="flex h-dvh" data-story-viewer data-active-index="<%= activeIndex %>">
  <!-- Left: story list -->
  <aside class="hidden w-[22.5rem] shrink-0 flex-col border-r border-line bg-surface md:flex" aria-label="Story list">
    <div class="flex items-center gap-2 px-4 pt-3">
      <a href="/" class="icon-btn bg-control" aria-label="Close stories"><svg class="icon"><use href="#i-x"/></svg></a>
      <a href="/" class="flex items-center gap-2" aria-label="Oremus home"><img src="/assets/brand/logo.svg" alt="" class="size-10"><span class="font-display text-[1.375rem] font-extrabold tracking-tight text-brand-600">Oremus</span></a>
    </div>
    <div class="px-4 pb-2 pt-4">
      <h1 class="font-display text-[1.75rem] font-extrabold">Stories</h1>
      <div class="mt-2 flex gap-2">
        <button type="button" class="chip" data-open-dialog="story-settings-dialog"><svg class="icon size-4"><use href="#i-settings"/></svg>Settings</button>
        <a class="chip" href="/stories/archive"><svg class="icon size-4"><use href="#i-archive"/></svg>Archive</a>
      </div>
    </div>
    <div class="flex-1 overflow-y-auto px-2 pb-6">
      <div class="mx-2 border-t border-line"></div>
      <h2 class="px-2 pb-2 pt-4 text-[1.0625rem] font-bold">Your story</h2>
      <% if (mine) { const i = tray.indexOf(mine); const last = mine.stories[mine.stories.length - 1]; %>
      <button type="button" class="story-row" data-story-jump="<%= i %>">
        <%- include('../partials/avatar', { person: mine.author, size: 'size-14 text-lg', ring: 'unseen' }) %>
        <span class="min-w-0"><span class="block truncate font-semibold"><%= mine.author.displayName %></span><span class="block text-[0.8125rem] text-muted"><%= plural(mine.stories.length, 'story', 'stories') %> · Added <%= timeAgo(last.createdAt) %> ago</span></span>
      </button>
      <button type="button" class="story-row" data-open-story-composer>
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600"><svg class="icon size-6"><use href="#i-plus"/></svg></span>
        <span class="font-semibold">Add to story</span>
      </button>
      <% } else { %>
      <button type="button" class="story-row" data-open-story-composer>
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600"><svg class="icon size-6"><use href="#i-plus"/></svg></span>
        <span class="min-w-0"><span class="block font-semibold">Create a story</span><span class="block text-[0.8125rem] text-muted">Share a photo or write something.</span></span>
      </button>
      <% } %>
      <h2 class="px-2 pb-2 pt-5 text-[1.0625rem] font-bold">Followed stories</h2>
      <% const followed = tray.filter(function (g) { return !g.isSelf; }); %>
      <% if (followed.length) { %>
      <ul class="space-y-0.5">
        <% followed.forEach(function (g) { const i = tray.indexOf(g); %>
        <li><button type="button" class="story-row <%= i === activeIndex ? 'story-row-active' : '' %>" data-story-jump="<%= i %>" data-story-row="<%= i %>">
          <%- include('../partials/avatar', { person: g.author, size: 'size-14 text-lg', ring: g.hasUnseen ? 'unseen' : 'seen' }) %>
          <span class="min-w-0"><span class="block truncate font-semibold"><%= g.author.displayName %></span><span class="block text-[0.8125rem] <%= g.hasUnseen ? 'font-semibold text-brand-600' : 'text-muted' %>" data-story-row-meta><%= g.hasUnseen ? `${g.stories.filter(function (s) { return !s.seen; }).length} new · ` : '' %><%= timeAgo(g.latestAt) %></span></span>
        </button></li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="px-2 text-15 text-muted">When people you follow share stories, they'll show up here. <a class="font-semibold text-brand-600 hover:underline" href="/search?kind=user">Find people to follow</a></p>
      <% } %>
    </div>
  </aside>

  <!-- Stage -->
  <section class="relative flex min-w-0 flex-1 items-center justify-center overflow-hidden bg-[#7b7c80]" aria-label="Story viewer">
    <a href="/" class="icon-btn absolute left-3 top-3 z-30 bg-black/40 text-white hover:bg-black/60 md:hidden" aria-label="Close stories"><svg class="icon"><use href="#i-x"/></svg></a>
    <% if (activeIndex === -1) { %>
      <div class="max-w-sm px-6 text-center text-white">
        <div class="mx-auto grid size-20 place-items-center rounded-full bg-white/15"><svg class="icon size-9"><use href="#i-stories"/></svg></div>
        <h2 class="mt-4 text-2xl font-bold"><%= missingAuthor ? 'No stories to show' : 'No stories yet' %></h2>
        <p class="mt-2 text-white/80"><%= missingAuthor ? "This person hasn't shared a story you can see right now." : 'Share a moment from your day — stories disappear after 24 hours.' %></p>
        <button type="button" class="btn-primary btn-lg mt-6" data-open-story-composer><svg class="icon"><use href="#i-plus"/></svg>Create a story</button>
      </div>
    <% } else { %>
    <div class="flex h-full w-full items-center justify-center gap-4 px-2 pb-4 pt-14 md:pt-4 lg:gap-6">
      <button type="button" class="story-side" data-story-side="prev" aria-label="Previous person's story"></button>
      <button type="button" class="icon-btn-float hidden shrink-0 sm:grid" data-story-nav="prev" aria-label="Previous story"><svg class="icon"><use href="#i-chevron-left"/></svg></button>

      <div class="flex h-full max-h-[52rem] flex-col items-center justify-center gap-4">
        <div class="relative aspect-[9/16] h-full max-h-[calc(100dvh-8rem)] max-w-[calc(100vw-1rem)] overflow-hidden rounded-xl bg-stage shadow-pop sm:max-h-[calc(100dvh-9rem)]" data-story-card>
          <div class="absolute inset-0 grid place-items-center" data-story-body>
            <img class="absolute inset-0 hidden size-full object-cover" alt="" data-story-image>
            <p class="relative z-10 hidden max-w-[85%] whitespace-pre-wrap break-words text-center font-display text-2xl font-bold leading-snug text-white text-shadow" data-story-text></p>
          </div>
          <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/55 to-transparent"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/60 to-transparent"></div>
          <!-- Tap zones -->
          <button type="button" class="absolute inset-y-16 left-0 z-10 w-1/3" data-story-nav="prev" aria-label="Previous story" tabindex="-1"></button>
          <button type="button" class="absolute inset-y-16 right-0 z-10 w-1/3" data-story-nav="next" aria-label="Next story" tabindex="-1"></button>
          <!-- Top -->
          <div class="absolute inset-x-0 top-0 z-20 px-3 pt-3">
            <div class="flex gap-1" data-story-progress></div>
            <div class="mt-3 flex items-center gap-2">
              <a class="flex min-w-0 flex-1 items-center gap-2" data-story-author-link>
                <span class="avatar size-10 bg-field text-sm" data-story-avatar></span>
                <span class="min-w-0 leading-tight"><span class="block truncate text-15 font-semibold text-white" data-story-author></span><span class="block text-[0.8125rem] text-white/80" data-story-time></span></span>
              </a>
              <button type="button" class="grid size-9 place-items-center rounded-full text-white hover:bg-white/15" data-story-pause aria-label="Pause"><svg class="icon"><use href="#i-pause" data-story-pause-icon/></svg></button>
              <details class="relative" data-menu>
                <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-white hover:bg-white/15" aria-label="Story options"><svg class="icon"><use href="#i-more"/></svg></summary>
                <div class="menu right-0 top-10 w-60">
                  <button type="button" class="menu-item hidden" data-story-delete><span class="menu-icon"><svg class="icon"><use href="#i-trash"/></svg></span>Delete story</button>
                  <a class="menu-item" data-story-profile-link><span class="menu-icon"><svg class="icon"><use href="#i-user"/></svg></span>View profile</a>
                  <a class="menu-item" href="/stories/archive"><span class="menu-icon"><svg class="icon"><use href="#i-archive"/></svg></span>Story archive</a>
                </div>
              </details>
            </div>
          </div>
          <!-- Caption over photo -->
          <p class="absolute inset-x-4 bottom-20 z-20 hidden whitespace-pre-wrap break-words text-center text-[1.0625rem] font-semibold text-white text-shadow" data-story-caption></p>
          <!-- Bottom: reply (others) or viewers (own) -->
          <div class="absolute inset-x-0 bottom-0 z-20 p-3">
            <form class="hidden items-center gap-2" data-story-reply>
              <label class="sr-only" for="story-reply-input">Write a reply</label>
              <input id="story-reply-input" name="content" maxlength="1000" autocomplete="off" required class="h-10 flex-1 rounded-full border border-white/60 bg-black/20 px-4 text-15 text-white placeholder:text-white/80 focus:border-white focus:outline-none" placeholder="Write a reply…">
              <button type="submit" class="grid size-10 place-items-center rounded-full text-white hover:bg-white/15" aria-label="Send reply"><svg class="icon"><use href="#i-send"/></svg></button>
            </form>
            <button type="button" class="hidden items-center gap-2 rounded-full bg-black/40 px-3 py-2 text-15 font-semibold text-white hover:bg-black/60" data-story-viewers><svg class="icon"><use href="#i-eye"/></svg><span data-story-viewers-label>0 viewers</span></button>
          </div>
        </div>
        <div class="flex items-center gap-2 sm:gap-3" role="toolbar" aria-label="React to story" data-story-reactions>
          <% [['love','Love'],['haha','Haha'],['angry','Angry'],['sad','Sad'],['like','Like']].forEach(function (r) { %>
          <button type="button" class="story-react" data-story-react="<%= r[0] %>" aria-label="<%= r[1] %>" aria-pressed="false" title="<%= r[1] %>"><svg><use href="#r-<%= r[0] %>"/></svg></button>
          <% }) %>
        </div>
      </div>

      <button type="button" class="icon-btn-float hidden shrink-0 sm:grid" data-story-nav="next" aria-label="Next story"><svg class="icon"><use href="#i-chevron-right"/></svg></button>
      <button type="button" class="story-side" data-story-side="next" aria-label="Next person's story"></button>
    </div>
    <% } %>
  </section>
</main>

<script type="application/json" id="story-data"><%- JSON.stringify({ tray, activeIndex, me: String(currentUser._id) }).replace(/</g, '\\u003c') %></script>

<dialog id="story-settings-dialog" class="w-[min(28rem,calc(100%-2rem))] rounded-xl p-0 shadow-pop" aria-labelledby="story-settings-title">
  <form data-api-form data-method="PATCH" action="/api/stories/settings" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="relative border-b border-line px-4 py-3 text-center"><h2 id="story-settings-title" class="text-xl font-bold">Story privacy</h2><button type="button" class="icon-btn absolute right-3 top-2" data-close-dialog="story-settings-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
    <fieldset class="space-y-1 p-4">
      <legend class="mb-2 text-15 text-muted">Who can see your stories by default?</legend>
      <label class="flex cursor-pointer items-center gap-3 rounded-lg p-2 hover:bg-hover"><span class="icon-btn"><svg class="icon"><use href="#i-globe"/></svg></span><span class="flex-1"><span class="block font-semibold">Public</span><span class="block text-[0.8125rem] text-muted">Anyone on Oremus</span></span><input type="radio" class="check size-5" name="audience" value="public" <%= storyAudience === 'public' ? 'checked' : '' %>></label>
      <label class="flex cursor-pointer items-center gap-3 rounded-lg p-2 hover:bg-hover"><span class="icon-btn"><svg class="icon"><use href="#i-users"/></svg></span><span class="flex-1"><span class="block font-semibold">Followers</span><span class="block text-[0.8125rem] text-muted">Only people who follow you</span></span><input type="radio" class="check size-5" name="audience" value="followers" <%= storyAudience !== 'public' ? 'checked' : '' %>></label>
      <p class="form-error mt-2 hidden" data-form-error role="alert"></p>
      <p class="form-success mt-2 hidden" data-form-success role="status"></p>
    </fieldset>
    <div class="px-4 pb-4"><button class="btn-primary w-full" type="submit">Save</button></div>
  </form>
</dialog>

<dialog id="story-viewers-dialog" class="w-[min(26rem,calc(100%-2rem))] rounded-xl p-0 shadow-pop" aria-labelledby="story-viewers-title">
  <div class="relative border-b border-line px-4 py-3 text-center"><h2 id="story-viewers-title" class="text-xl font-bold">Story viewers</h2><button type="button" class="icon-btn absolute right-3 top-2" data-close-dialog="story-viewers-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
  <ul class="max-h-[60dvh] overflow-y-auto p-2" data-story-viewers-list></ul>
</dialog>
<%- include('../partials/foot', { hideMobileNav: true }) %>
