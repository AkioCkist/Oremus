<%- include('../partials/head') %><%- include('../partials/nav') %>
<main id="main" class="app-shell !max-w-5xl">
  <section class="mx-auto w-full max-w-5xl space-y-4">
    <div class="page-header flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="page-title">Story archive</h1>
        <p class="page-subtitle max-w-xl">Only you can see your archive. Active stories disappear from your profile after 24 hours but stay here.</p>
      </div>
      <div class="flex gap-2"><a class="btn-secondary" href="/stories">View stories</a><button class="btn-primary" type="button" data-open-story-composer><svg class="icon"><use href="#i-plus"/></svg>Create story</button></div>
    </div>
    <% if (items.length) { %>
    <ul class="grid grid-cols-2 gap-3 px-3 sm:grid-cols-3 sm:px-0 lg:grid-cols-4 xl:grid-cols-5" data-infinite="story-archive" data-infinite-next="<%= next || '' %>" data-infinite-prefetch="8">
      <%- include('../partials/chunks/story-archive', { items }) %>
    </ul>
    <% } else { %>
    <div class="empty-state"><div class="empty-icon"><svg class="icon size-7"><use href="#i-archive"/></svg></div><h2 class="mt-4 text-xl font-bold">No stories in your archive</h2><p class="mt-1 text-muted">Stories you share are saved here automatically.</p><button class="btn-primary mt-5" type="button" data-open-story-composer>Create your first story</button></div>
    <% } %>
  </section>
</main>
<%- include('../partials/foot') %>
