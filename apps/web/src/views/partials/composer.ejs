<%# Group composer row, opens the shared #composer-dialog. The home feed has none: Create lives in the navigation. Locals: composerGroup ({ _id, name }). -%>
<% const cg = locals.composerGroup || null; const groupAttrs = cg ? `data-group-id="${cg._id}" data-group-name="${cg.name}"` : ''; -%>
<section class="post-pad flex items-center gap-2.5 border-b border-line py-3" aria-label="Create a post">
  <a href="/profile/<%= currentUser.username %>" class="shrink-0" aria-label="Your profile"><%- include('avatar', { person: currentUser, size: 'size-8 text-xs' }) %></a>
  <button type="button" class="h-9 min-w-0 flex-1 truncate rounded-full bg-field px-4 text-left text-subheadline text-muted transition-colors hover:bg-control" data-open-composer <%- groupAttrs %>>
    <%= cg ? `Write something to ${cg.name}…` : `What's on your mind, ${firstName(currentUser.displayName)}?` %>
  </button>
  <button type="button" class="icon-btn-ghost text-ink" data-open-composer data-pick-photo <%- groupAttrs %> aria-label="Add photo or video"><svg class="icon"><use href="#i-image"/></svg></button>
</section>
