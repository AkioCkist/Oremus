<%# Group directory cards. Used by groups/index.ejs and GET /api/lists/groups. %>
<% items.forEach(function (g) { %>
<li class="group-card" data-group-name="<%= g.name.toLowerCase() %>" data-key="<%= g._id %>">
  <a href="/groups/<%= g.slug %>" class="block size-full" aria-label="<%= g.name %>">
    <img class="group-card-image" src="<%= g.coverUrl || '/assets/img/default-cover.svg' %>" alt="" loading="lazy">
    <span class="group-card-text">
      <span class="block truncate text-headline font-semibold"><%= g.name %></span>
      <span class="mt-0.5 flex items-center gap-1 text-footnote text-white/80"><svg class="icon size-3.5"><use href="#<%= g.visibility === 'hidden' ? 'i-eye-off' : g.privacy === 'private' ? 'i-lock' : 'i-globe' %>"/></svg><%= plural(g.memberCount, 'member') %></span>
    </span>
  </a>
  <% if (g.isMember) { %><span class="btn-outline group-card-action pointer-events-none"><svg class="icon size-4"><use href="#i-check"/></svg>Joined</span>
  <% } else if (!currentUser) { %><a class="btn-outline group-card-action" href="/login">Join</a>
  <% } else if (g.privacy === 'private') { %><a class="btn-outline group-card-action" href="/groups/<%= g.slug %>">Request</a>
  <% } else { %><button type="button" class="btn-outline group-card-action" data-group-join="<%= g._id %>">Join</button><% } %>
</li>
<% }) %>
