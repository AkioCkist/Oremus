<%# Notification rows. Used by notifications.ejs (first chunk) and GET /api/lists/notifications (next chunks). %>
<%
  const meta = {
    reaction: { icon: 'r-like', fill: true, bg: '' },
    story_reaction: { icon: 'r-love', fill: true, bg: '' },
    comment: { icon: 'i-comment', bg: 'bg-[#34c759]' },
    follow: { icon: 'i-user-plus', bg: 'bg-brand-600' },
    friend_request: { icon: 'i-user-plus', bg: 'bg-brand-600' },
    friend_accept: { icon: 'i-users', bg: 'bg-brand-600' },
    group_request: { icon: 'i-group', bg: 'bg-[#ff8d28]' },
    group_invite: { icon: 'i-group', bg: 'bg-brand-600' },
    group_post: { icon: 'i-feed', bg: 'bg-[#34c759]' },
    message: { icon: 'i-chat', bg: 'bg-[#0088ff]' },
    share: { icon: 'i-share', bg: 'bg-brand-600' }
  };
  const hrefOf = function (n) {
    if (n.entityType === 'Post') return `/posts/${n.entityId}`;
    if (n.entityType === 'Conversation') return `/messages/${n.entityId}`;
    if (n.entityType === 'Group') return `/g/${n.entityId}`;
    if (n.entityType === 'Story') return '/stories/archive';
    return `/profile/${n.actorId.username}`;
  };
  // Everything was marked read when the page opened; anything read at that moment still counts as new for this visit.
  const opened = new Date(openedAt).getTime();
  const isNew = function (n) { return !n.readAt || new Date(n.readAt).getTime() >= opened; };
-%>
<% items.forEach(function (n) { const m = meta[n.type] || meta.follow; const fresh = isNew(n); %>
<li data-key="<%= n._id %>">
  <a class="flex items-center gap-3 rounded-lg p-2 hover:bg-hover" href="<%= hrefOf(n) %>" data-unread="<%= fresh ? 'true' : 'false' %>">
    <span class="relative shrink-0">
      <%- include('../avatar', { person: n.actorId, size: 'size-14 text-lg' }) %>
      <span class="absolute -bottom-1 -right-1 grid size-7 place-items-center rounded-full text-white ring-2 ring-surface <%= m.bg %>">
        <% if (m.fill) { %><svg class="size-7"><use href="#<%= m.icon %>"/></svg><% } else { %><svg class="icon size-4"><use href="#<%= m.icon %>"/></svg><% } %>
      </span>
    </span>
    <span class="min-w-0 flex-1">
      <span class="line-clamp-3 text-15 <%= fresh ? '' : 'text-muted' %>"><strong class="font-semibold text-ink"><%= n.actorId.displayName %></strong> <%= n.text %></span>
      <span class="mt-0.5 block text-[0.8125rem] <%= fresh ? 'font-semibold text-brand-600' : 'text-muted' %>" data-unread-time><%= timeAgo(n.createdAt) %></span>
    </span>
    <% if (fresh) { %><span class="size-3 shrink-0 rounded-full bg-brand-600" data-unread-dot aria-label="Unread"></span><% } %>
  </a>
  <% if (n.type === 'friend_request' && n.friendState === 'incoming') { %>
  <div class="ml-[4.25rem] pb-3 pr-3"><%- include('../friend-controls', { person: n.actorId, state: n.friendState, compact: true, full: false }) %></div>
  <% } %>
</li>
<% }) %>
