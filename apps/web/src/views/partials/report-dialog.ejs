<dialog id="report-dialog" class="w-[min(30rem,calc(100%-2rem))] rounded-sheet p-0 shadow-pop" aria-labelledby="report-title" aria-describedby="report-description">
  <div class="flex items-center justify-between border-b border-line px-4 py-3"><h2 id="report-title" class="text-balance text-xl font-bold">Report</h2><button type="button" class="icon-btn" data-close-dialog="report-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
  <form data-report-form class="space-y-3 p-4">
    <p id="report-description" class="text-pretty text-15 text-muted">Tell us what's wrong. The person won't know who reported this. If someone is in immediate danger, contact local emergency services.</p>
    <fieldset class="space-y-1">
      <legend class="sr-only">Reason</legend>
      <% [['harassment', 'Harassment or bullying'], ['hate', 'Hate speech'], ['sexual', 'Sexual content'], ['violence', 'Violence or threats'], ['self_harm', 'Suicide or self-harm'], ['spam', 'Spam'], ['scam', 'Scam or fraud'], ['other', 'Something else']].forEach(function (option, index) { %>
      <label class="flex cursor-pointer items-center gap-3 rounded-lg p-2 hover:bg-hover"><input type="radio" class="check size-5 shrink-0" name="reason" value="<%= option[0] %>" required <%= index === 0 ? 'checked' : '' %>><span class="text-15"><%= option[1] %></span></label>
      <% }) %>
    </fieldset>
    <div><label class="label" for="report-note">Anything else? (optional)</label><textarea class="input mt-1.5 w-full" id="report-note" name="note" rows="2" maxlength="500"></textarea></div>
    <p class="hidden form-error" role="alert" data-report-error></p>
    <div class="flex justify-end gap-2"><button type="button" class="btn-secondary" data-close-dialog="report-dialog">Cancel</button><button type="submit" class="btn-primary" data-report-save>Send report</button></div>
  </form>
</dialog>
