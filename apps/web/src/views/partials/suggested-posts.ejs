<%# "Suggested for you" rail in the home feed (not an endless-list item: it carries no data-key). Locals: posts (RecPost[]). -%>
<% const list = locals.posts || []; if (list.length) { -%>
<section class="relative border-b border-line pb-4 pt-3" aria-labelledby="suggested-posts-title" data-rail-wrap data-suggested-posts>
  <div class="post-pad flex items-center justify-between pb-2">
    <h2 id="suggested-posts-title" class="text-subheadline font-semibold">Suggested for you</h2>
    <a class="text-footnote font-semibold text-brand-600 hover:text-ink" href="/discover">See all</a>
  </div>
  <div class="flex snap-x gap-1 overflow-x-auto px-3 [scrollbar-width:none] sm:px-0" data-rail>
    <% list.forEach(function (post) { %><%- include('rec-post-card', { post }) %><% }) %>
  </div>
  <% if (list.length > 3) { %>
  <button type="button" class="icon-btn-float absolute right-2 top-1/2 z-10 hidden size-8 sm:grid" data-scroll-rail aria-label="More suggested posts"><svg class="icon size-4"><use href="#i-chevron-right"/></svg></button>
  <% } %>
</section>
<% } -%>
