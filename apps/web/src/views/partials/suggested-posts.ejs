<%# "Suggested for you" carousel in the home feed (not an endless-list item: it carries no data-key). Locals: posts (RecPost[]). -%>
<% const list = locals.posts || []; if (list.length) { -%>
<section class="relative py-1" aria-labelledby="suggested-posts-title" data-rail-wrap data-suggested-posts>
  <div class="flex items-center justify-between px-4 pb-2 sm:px-1">
    <h2 id="suggested-posts-title" class="flex items-center gap-1.5 text-headline font-semibold"><svg class="icon size-[1.125rem] text-ios-purple"><use href="#i-sparkles"/></svg>Suggested for you</h2>
    <a class="text-subheadline text-brand-600 hover:underline" href="/discover">See all</a>
  </div>
  <div class="scrollbar-none flex snap-x scroll-px-4 items-stretch gap-3 overflow-x-auto px-4 pb-2 sm:scroll-px-0 sm:px-0" data-rail>
    <% list.forEach(function (post) { %><%- include('rec-post-card', { post }) %><% }) %>
  </div>
  <% if (list.length > 2) { %>
  <button type="button" class="icon-btn-float absolute right-3 top-1/2 z-10 hidden -translate-y-1/2 sm:grid" data-scroll-rail aria-label="More suggested posts"><svg class="icon"><use href="#i-chevron-right"/></svg></button>
  <% } %>
</section>
<% } -%>
