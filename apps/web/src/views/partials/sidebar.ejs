<% const sideGroups = locals.groups || []; const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href); -%>
<aside class="hidden lg:block" aria-label="Shortcuts">
  <div class="rail-sticky px-2">
    <nav aria-label="Personal" class="space-y-0.5">
      <a class="side-link <%= isActive('/') ? 'side-link-active' : '' %>" href="/"><span class="side-icon text-brand-600"><svg class="icon size-6"><use href="#i-home"/></svg></span>Home</a>
      <a class="side-link" href="/profile/<%= currentUser.username %>"><span class="side-icon"><%- include('avatar', { person: currentUser, size: 'size-9 text-xs' }) %></span><span class="truncate"><%= currentUser.displayName %></span></a>
    </nav>
    <h2 class="side-heading">Favorites</h2>
    <nav aria-label="Favorites" class="space-y-0.5">
      <a class="side-link <%= isActive('/messages') ? 'side-link-active' : '' %>" href="/messages" data-badge-link="messages" data-badge-class="ml-auto !static grid h-5 min-w-5 place-items-center px-1.5"><span class="side-icon"><svg class="icon size-6"><use href="#i-chat"/></svg></span>Messages<% if (locals.unreadMessages) { %><span class="badge ml-auto !static grid h-5 min-w-5 place-items-center px-1.5" data-badge><%= unreadMessages > 9 ? '9+' : unreadMessages %></span><% } %></a>
      <a class="side-link <%= isActive('/stories') && !isActive('/stories/archive') ? 'side-link-active' : '' %>" href="/stories"><span class="side-icon"><svg class="icon size-6"><use href="#i-stories"/></svg></span>Stories</a>
      <a class="side-link <%= isActive('/groups') ? 'side-link-active' : '' %>" href="/groups"><span class="side-icon"><svg class="icon size-6"><use href="#i-group"/></svg></span>Groups</a>
      <a class="side-link <%= isActive('/search') ? 'side-link-active' : '' %>" href="/search?kind=user"><span class="side-icon"><svg class="icon size-6"><use href="#i-users"/></svg></span>Find friends</a>
      <a class="side-link <%= isActive('/notifications') ? 'side-link-active' : '' %>" href="/notifications" data-badge-link="notifications" data-badge-class="ml-auto !static grid h-5 min-w-5 place-items-center px-1.5"><span class="side-icon"><svg class="icon size-6"><use href="#i-bell"/></svg></span>Notifications<% if (locals.unreadNotifications) { %><span class="badge ml-auto !static grid h-5 min-w-5 place-items-center px-1.5" data-badge><%= unreadNotifications > 9 ? '9+' : unreadNotifications %></span><% } %></a>
      <a class="side-link <%= isActive('/stories/archive') ? 'side-link-active' : '' %>" href="/stories/archive"><span class="side-icon"><svg class="icon size-6"><use href="#i-archive"/></svg></span>Story archive</a>
      <a class="side-link <%= isActive('/settings') ? 'side-link-active' : '' %>" href="/settings"><span class="side-icon"><svg class="icon size-6"><use href="#i-settings"/></svg></span>Settings</a>
    </nav>
    <% if (sideGroups.length) { %>
    <div class="divider mx-2"></div>
    <h2 class="side-heading">Your groups</h2>
    <nav aria-label="Your groups" class="space-y-0.5">
      <% sideGroups.forEach(function (g) { %>
      <a class="side-link" href="/groups/<%= g.slug %>">
        <span class="grid size-9 shrink-0 place-items-center overflow-hidden rounded-lg <%= g.coverUrl ? 'bg-field' : toneOf(g.name) %>"><% if (g.coverUrl) { %><img class="size-full object-cover" src="<%= g.coverUrl %>" alt=""><% } else { %><span class="font-display text-sm font-bold text-white"><%= initials(g.name) %></span><% } %></span>
        <span class="truncate"><%= g.name %></span>
      </a>
      <% }) %>
    </nav>
    <% } %>
    <p class="mt-4 px-2 text-xs leading-5 text-muted">Privacy · Terms · Community guidelines · Oremus © <%= new Date().getFullYear() %></p>
  </div>
</aside>
