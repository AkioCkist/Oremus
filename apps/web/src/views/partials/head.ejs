<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#4150cf">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="description" content="Oremus helps you share moments and stay close to the people and communities you care about.">
  <title><%= title %> · Oremus</title>
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@500;600;700;800&family=Red+Hat+Text:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css?v=<%= assetVersion %>">
</head>
<body class="min-h-dvh antialiased <%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (typeof currentUser !== 'undefined' && currentUser) { %> data-user-id="<%= currentUser._id %>" data-user-name="<%= currentUser.displayName %>" data-user-username="<%= currentUser.username %>" data-user-avatar="<%= (currentUser.profile && currentUser.profile.avatarUrl) || '' %>"<% } %>>
<%- include('icons') %>
<a class="skip-link" href="#main">Skip to content</a>
