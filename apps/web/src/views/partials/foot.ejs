<div id="toast-region" class="pointer-events-none fixed bottom-20 left-4 z-[60] flex flex-col gap-2 md:bottom-6" aria-live="polite" aria-atomic="true"></div>
<% if (currentUser) { %><%- include('break-dialog') %><% } %>

<dialog id="confirm-dialog" class="w-[min(30rem,calc(100%-2rem))] rounded-xl p-0 shadow-pop" role="alertdialog" aria-labelledby="confirm-title" aria-describedby="confirm-description">
  <div class="flex items-center justify-between border-b border-line px-4 py-3"><h2 id="confirm-title" class="mx-auto pl-9 text-xl font-bold">Move to trash?</h2><button class="icon-btn" value="cancel" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
  <p id="confirm-description" class="px-4 py-4 text-15 text-ink">This can't be undone.</p>
  <div class="flex justify-end gap-2 px-4 pb-4"><button class="btn text-brand-600 hover:bg-hover" value="cancel">Cancel</button><button class="btn-primary px-6" value="confirm" data-confirm-label>Delete</button></div>
</dialog>

<dialog id="lightbox" class="dialog-dark m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden bg-black p-0" aria-label="Photo viewer" data-photo-viewer>
  <div class="flex h-full">
    <!-- Stage: the photo always fits between top and bottom; empty space stays black -->
    <div class="relative flex min-w-0 flex-1 select-none items-center justify-center overflow-hidden bg-black" data-viewer-stage>
      <img class="size-full object-contain transition-transform duration-150 will-change-transform" alt="" draggable="false" data-lightbox-image>
      <video class="hidden size-full object-contain" controls playsinline preload="metadata" data-lightbox-video></video>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/60 to-transparent"></div>
      <div class="absolute left-3 top-3 flex items-center gap-2">
        <button type="button" class="grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" data-close-dialog="lightbox" aria-label="Close photo viewer"><svg class="icon"><use href="#i-x"/></svg></button>
        <img src="/assets/brand/logo.svg" alt="" class="size-10">
      </div>
      <div class="absolute right-3 top-3 flex items-center gap-1.5">
        <button type="button" class="grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20 disabled:opacity-40" data-viewer-zoom="in" aria-label="Zoom in" title="Zoom in"><svg class="icon"><use href="#i-zoom-in"/></svg></button>
        <button type="button" class="grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20 disabled:opacity-40" data-viewer-zoom="out" aria-label="Zoom out" title="Zoom out"><svg class="icon"><use href="#i-zoom-out"/></svg></button>
        <button type="button" class="grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" data-viewer-fullscreen aria-label="Enter full screen" title="Full screen"><svg class="icon"><use href="#i-expand"/></svg></button>
        <button type="button" class="hidden size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20 lg:hidden" data-viewer-toggle-panel aria-label="Show comments" title="Comments"><svg class="icon"><use href="#i-comment"/></svg></button>
      </div>
      <button type="button" class="absolute left-4 top-1/2 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/25" data-viewer-nav="-1" aria-label="Previous photo"><svg class="icon size-6"><use href="#i-chevron-left"/></svg></button>
      <button type="button" class="absolute right-4 top-1/2 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/25" data-viewer-nav="1" aria-label="Next photo"><svg class="icon size-6"><use href="#i-chevron-right"/></svg></button>
      <span class="absolute bottom-4 left-1/2 hidden -translate-x-1/2 rounded-full bg-black/60 px-3 py-1 text-[0.8125rem] font-semibold text-white" data-viewer-counter></span>
    </div>

    <!-- Post panel (Facebook-style right column) -->
    <aside class="hidden w-full shrink-0 flex-col bg-surface text-ink max-lg:absolute max-lg:inset-x-0 max-lg:bottom-0 max-lg:top-16 max-lg:rounded-t-2xl lg:w-[22.5rem]" data-viewer-panel aria-label="Post details">
      <div class="flex items-center gap-2.5 px-4 pb-2 pt-4">
        <a data-viewer-author-link class="shrink-0"><span data-viewer-avatar></span></a>
        <div class="min-w-0 flex-1 leading-tight">
          <p class="text-15" data-viewer-title></p>
          <p class="mt-0.5 flex items-center gap-1 text-[0.8125rem] text-muted"><a class="hover:underline" data-viewer-time></a><span aria-hidden="true">·</span><svg class="icon size-3.5"><use href="#i-globe" data-viewer-privacy/></svg></p>
        </div>
        <button type="button" class="icon-btn-ghost lg:hidden" data-viewer-toggle-panel aria-label="Hide comments"><svg class="icon"><use href="#i-x"/></svg></button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto" data-viewer-scroll>
        <p class="whitespace-pre-wrap break-words px-4 text-15 leading-[1.4]" data-viewer-content></p>
        <div class="mx-4 mt-2 flex min-h-[2.5rem] items-center justify-between gap-3 text-15 text-muted">
          <span class="flex items-center gap-1.5" data-viewer-reactions></span>
          <span data-viewer-comment-count></span>
        </div>
        <div class="mx-4 flex gap-1 border-y border-line py-1">
          <div class="reaction-wrap relative flex flex-1" data-viewer-react-wrap>
            <button type="button" class="action-button" data-viewer-like><svg class="icon"><use href="#i-like"/></svg><span>Like</span></button>
            <div class="reaction-bar" role="toolbar" aria-label="Reactions" data-viewer-reaction-bar></div>
          </div>
          <button type="button" class="action-button" data-viewer-focus-comment><svg class="icon"><use href="#i-comment"/></svg><span>Comment</span></button>
          <button type="button" class="action-button" data-viewer-share><svg class="icon"><use href="#i-share"/></svg><span>Share</span></button>
        </div>
        <ul class="space-y-3 px-4 py-3" data-viewer-comments></ul>
      </div>
      <form class="border-t border-line p-3" data-viewer-comment-form>
        <p class="mb-1.5 hidden items-center justify-between text-xs text-muted" data-viewer-replying><span></span><button type="button" class="font-semibold hover:underline" data-viewer-cancel-reply>Cancel</button></p>
        <div class="flex items-center gap-2">
          <span data-viewer-me></span>
          <label class="sr-only" for="viewer-comment">Write a comment</label>
          <div class="relative flex-1">
            <input id="viewer-comment" class="pill-input h-9 pr-16" placeholder="Write a comment…" maxlength="1500" autocomplete="off" required>
            <button type="button" class="absolute right-8 top-1/2 grid size-7 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-line" data-emoji-for="#viewer-comment" aria-label="Insert emoji"><svg class="icon size-4"><use href="#i-smile"/></svg></button>
            <button type="submit" class="absolute right-1 top-1/2 grid size-7 -translate-y-1/2 place-items-center rounded-full text-brand-600 hover:bg-line" aria-label="Post comment"><svg class="icon size-4"><use href="#i-send"/></svg></button>
          </div>
        </div>
      </form>
    </aside>
  </div>
</dialog>

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<dialog id="composer-dialog" class="w-[min(31.25rem,calc(100%-1.5rem))] rounded-xl p-0 shadow-pop" aria-labelledby="composer-title">
  <form data-api-form data-reload action="/api/posts" method="post" enctype="multipart/form-data" data-composer-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="groupId" value="" data-composer-group disabled>
    <input type="hidden" name="feeling" value="" data-composer-feeling-input>
    <input type="hidden" name="place" value="" data-composer-place-input>

    <!-- Main view -->
    <div data-composer-view="main">
      <div class="relative border-b border-line px-4 py-3 text-center"><h2 id="composer-title" class="text-xl font-bold">Create post</h2><button type="button" class="icon-btn absolute right-3 top-2" data-close-dialog="composer-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
      <div class="max-h-[65dvh] overflow-y-auto p-4">
        <div class="flex items-start gap-2.5">
          <%- include('avatar', { person: currentUser, size: 'size-10 text-sm' }) %>
          <div class="min-w-0">
            <p class="text-15 leading-snug"><strong class="font-semibold"><%= currentUser.displayName %></strong><span class="text-muted" data-composer-group-label></span><span data-composer-meta></span></p>
            <label class="sr-only" for="composer-visibility">Who can see this post</label>
            <div class="relative mt-1 inline-flex" data-visibility-wrap>
              <svg class="icon pointer-events-none absolute left-2 top-1/2 size-3.5 -translate-y-1/2"><use href="#i-globe"/></svg>
              <select id="composer-visibility" name="visibility" class="h-7 appearance-none rounded-md bg-control pl-7 pr-7 text-[0.8125rem] font-semibold focus:outline-none focus:ring-2 focus:ring-brand-200">
                <option value="public">Public</option><option value="followers">Followers</option><option value="private">Only me</option>
              </select>
              <svg class="icon pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2"><use href="#i-chevron-down"/></svg>
            </div>
          </div>
        </div>
        <div class="relative mt-3">
          <label class="sr-only" for="composer-content">Post text</label>
          <textarea id="composer-content" name="content" maxlength="5000" rows="4" class="field-bare w-full resize-none p-0 pr-10 text-2xl leading-snug placeholder:text-subtle" placeholder="What's on your mind, <%= firstName(currentUser.displayName) %>?"></textarea>
          <button type="button" class="icon-btn-ghost absolute bottom-0 right-0" data-emoji-for="#composer-content" aria-label="Insert emoji" title="Emoji"><svg class="icon"><use href="#i-smile"/></svg></button>
        </div>
        <div class="mt-2 grid hidden max-h-[22rem] grid-cols-2 gap-1 overflow-y-auto rounded-lg border border-line p-1" data-composer-previews></div>
        <%- include('post-place-card') %>
        <p class="form-error mt-3 hidden" data-form-error role="alert"></p>
      </div>
      <div class="px-4 pb-4">
        <div class="flex items-center justify-between rounded-lg border border-strong px-4 py-2">
          <span class="text-15 font-semibold">Add to your post</span>
          <div class="flex items-center gap-1">
            <label class="icon-btn-ghost cursor-pointer text-[#45bd62]" title="Photo/video"><svg class="icon size-6"><use href="#i-image"/></svg><span class="sr-only">Add photos or videos</span><input class="sr-only" name="images" type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" multiple data-composer-files></label>
            <button type="button" class="icon-btn-ghost text-[#f7b928]" title="Feeling/activity" data-composer-open="feeling"><svg class="icon size-6"><use href="#i-smile"/></svg><span class="sr-only">Feeling or activity</span></button>
            <button type="button" class="icon-btn-ghost text-[#f5533d]" title="Check in" data-composer-open="place"><svg class="icon size-6"><use href="#i-pin"/></svg><span class="sr-only">Check in</span></button>
          </div>
        </div>
        <button class="btn-primary mt-3 w-full" type="submit">Post</button>
      </div>
    </div>

    <%- include('post-extra-views') %>
  </form>
</dialog>

<dialog id="edit-post-dialog" class="w-[min(31.25rem,calc(100%-1.5rem))] rounded-xl p-0 shadow-pop" aria-labelledby="edit-post-title">
  <form id="edit-post-form" method="post" data-edit-post-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" value="" data-composer-feeling-input>
    <input type="hidden" value="" data-composer-place-input>

    <!-- Main view -->
    <div data-composer-view="main">
      <div class="relative border-b border-line px-4 py-3 text-center"><h2 id="edit-post-title" class="text-xl font-bold">Edit post</h2><button type="button" class="icon-btn absolute right-3 top-2" data-close-dialog="edit-post-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
      <div class="max-h-[65dvh] overflow-y-auto p-4">
        <div class="flex items-start gap-2.5">
          <%- include('avatar', { person: currentUser, size: 'size-10 text-sm' }) %>
          <div class="min-w-0">
            <p class="text-15 leading-snug"><strong class="font-semibold"><%= currentUser.displayName %></strong><span class="text-muted" data-edit-group-label></span><span data-composer-meta></span></p>
            <label class="sr-only" for="edit-post-visibility">Who can see this post</label>
            <div class="relative mt-1 inline-flex" data-edit-visibility-wrap>
              <svg class="icon pointer-events-none absolute left-2 top-1/2 size-3.5 -translate-y-1/2"><use href="#i-globe" data-edit-visibility-icon/></svg>
              <select id="edit-post-visibility" class="h-7 appearance-none rounded-md bg-control pl-7 pr-7 text-[0.8125rem] font-semibold focus:outline-none focus:ring-2 focus:ring-brand-200" data-edit-visibility>
                <option value="public">Public</option><option value="followers">Followers</option><option value="private">Only me</option>
              </select>
              <svg class="icon pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2"><use href="#i-chevron-down"/></svg>
            </div>
          </div>
        </div>
        <div class="relative mt-3">
          <label class="sr-only" for="edit-post-content">Post text</label>
          <textarea class="field-bare w-full resize-none p-0 pr-10 text-xl leading-snug placeholder:text-subtle" id="edit-post-content" name="content" rows="4" maxlength="5000" placeholder="What's on your mind?"></textarea>
          <button type="button" class="icon-btn-ghost absolute bottom-0 right-0" data-emoji-for="#edit-post-content" aria-label="Insert emoji" title="Emoji"><svg class="icon"><use href="#i-smile"/></svg></button>
        </div>
        <div class="mt-2 grid max-h-[22rem] grid-cols-2 gap-1 overflow-y-auto rounded-lg border border-line p-1 empty:hidden" data-edit-media></div>
        <%- include('post-place-card') %>
        <p class="mt-2 text-[0.8125rem] text-muted">Use the buttons on each photo or video to replace or remove it. Photos up to 8 MB, videos up to 200 MB.</p>
        <p class="form-error mt-3 hidden" data-form-error role="alert"></p>
      </div>
      <div class="px-4 pb-4">
        <div class="flex items-center justify-between rounded-lg border border-strong px-4 py-2">
          <span class="text-15 font-semibold">Add to your post</span>
          <div class="flex items-center gap-1">
            <button type="button" class="icon-btn-ghost text-[#45bd62]" title="Photo/video" data-edit-add-media><svg class="icon size-6"><use href="#i-image"/></svg><span class="sr-only">Add photos or videos</span></button>
            <button type="button" class="icon-btn-ghost text-[#f7b928]" title="Feeling/activity" data-composer-open="feeling"><svg class="icon size-6"><use href="#i-smile"/></svg><span class="sr-only">Feeling or activity</span></button>
            <button type="button" class="icon-btn-ghost text-[#f5533d]" title="Check in" data-composer-open="place"><svg class="icon size-6"><use href="#i-pin"/></svg><span class="sr-only">Check in</span></button>
          </div>
        </div>
        <button class="btn-primary mt-3 w-full" type="submit">Save</button>
      </div>
    </div>

    <%- include('post-extra-views') %>
  </form>
</dialog>

<%- include('profile-dialogs') %>

<dialog id="story-dialog" class="w-[min(56rem,calc(100%-1.5rem))] rounded-xl p-0 shadow-pop" aria-labelledby="story-dialog-title">
  <form data-api-form action="/api/stories" method="post" enctype="multipart/form-data" data-story-form class="grid md:grid-cols-[20rem_1fr]">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="background" value="ocean" data-story-background>
    <div class="flex flex-col border-b border-line p-4 md:border-b-0 md:border-r">
      <div class="flex items-center justify-between"><h2 id="story-dialog-title" class="text-2xl font-bold">Your story</h2><button type="button" class="icon-btn" data-close-dialog="story-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
      <div class="mt-3 flex items-center gap-3"><%- include('avatar', { person: currentUser, size: 'size-12 text-base' }) %><span class="font-semibold"><%= currentUser.displayName %></span></div>
      <div class="divider my-4"></div>
      <label class="label" for="story-text">Text</label>
      <textarea id="story-text" name="text" maxlength="250" rows="4" class="input mt-2 w-full resize-none" placeholder="Start typing" data-story-text></textarea>
      <p class="label mt-4">Backgrounds</p>
      <div class="mt-2 flex flex-wrap gap-2" role="radiogroup" aria-label="Story background">
        <% ['ocean','sunset','forest','night','candy','sun'].forEach(function (bg, i) { %>
        <button type="button" role="radio" aria-checked="<%= i === 0 ? 'true' : 'false' %>" aria-label="<%= bg %> background" class="size-8 rounded-full bg-story-<%= bg %> ring-offset-2 aria-checked:ring-2 aria-checked:ring-brand-600" data-story-bg="<%= bg %>"></button>
        <% }) %>
      </div>
      <label class="label mt-4" for="story-audience">Audience</label>
      <select id="story-audience" name="audience" class="input mt-2 h-10 w-full">
        <option value="followers" <%= (currentUser.profile && currentUser.profile.storyAudience) !== 'public' ? 'selected' : '' %>>Followers</option>
        <option value="public" <%= currentUser.profile && currentUser.profile.storyAudience === 'public' ? 'selected' : '' %>>Public</option>
      </select>
      <p class="form-error mt-4 hidden" data-form-error role="alert"></p>
      <div class="mt-auto flex gap-2 pt-6"><button type="button" class="btn-secondary flex-1" data-story-reset>Discard</button><button type="submit" class="btn-primary flex-1">Share to story</button></div>
    </div>
    <div class="grid place-items-center bg-canvas p-4 md:p-6">
      <p class="mb-3 self-start text-15 font-semibold">Preview</p>
      <div class="relative grid aspect-[9/16] w-full max-w-[16rem] place-items-center overflow-hidden rounded-xl bg-story-ocean shadow-float" data-story-preview>
        <img class="absolute inset-0 hidden size-full object-cover" alt="" data-story-preview-image>
        <div class="absolute right-2 top-2 z-20 hidden gap-1.5" data-story-photo-actions>
          <button type="button" class="grid size-9 place-items-center rounded-full bg-surface/90 text-ink shadow-float hover:bg-surface" data-story-photo="replace" aria-label="Replace photo" title="Replace photo"><svg class="icon size-[1.125rem]"><use href="#i-edit"/></svg></button>
          <button type="button" class="grid size-9 place-items-center rounded-full bg-surface/90 text-ink shadow-float hover:bg-surface" data-story-photo="remove" aria-label="Remove photo" title="Remove photo"><svg class="icon size-[1.125rem]"><use href="#i-x"/></svg></button>
        </div>
        <p class="relative z-10 whitespace-pre-wrap break-words px-5 text-center font-display text-xl font-bold text-white text-shadow" data-story-preview-text>Start typing</p>
      </div>
      <label class="btn-secondary mt-4 cursor-pointer"><svg class="icon"><use href="#i-image"/></svg>Add photo<input class="sr-only" type="file" name="media" accept="image/jpeg,image/png,image/webp,image/gif" data-story-file></label>
    </div>
  </form>
</dialog>
<% } %>

<%- include('mobile-nav') %>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js" defer></script>
<script type="module" src="/assets/app.js?v=<%= assetVersion %>"></script>
</body>
</html>
