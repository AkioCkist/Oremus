<div id="toast-region" class="fixed bottom-20 right-4 z-50 space-y-2" aria-live="polite" aria-atomic="true"></div>
<dialog id="confirm-dialog" class="w-[min(28rem,calc(100%-2rem))] rounded-xl border border-stone-200 p-0 shadow-lg" role="alertdialog" aria-labelledby="confirm-title" aria-describedby="confirm-description">
  <div class="p-6"><h2 id="confirm-title" class="text-xl font-semibold">Delete this post?</h2><p id="confirm-description" class="mt-2 text-pretty text-stone-600">This action cannot be undone.</p><div class="mt-6 flex justify-end gap-3"><button class="button-secondary" value="cancel">Cancel</button><button class="rounded-lg bg-red-700 px-4 py-2 font-semibold text-white hover:bg-red-800" value="confirm">Delete post</button></div></div>
</dialog>
<dialog id="edit-post-dialog" class="w-[min(34rem,calc(100%-2rem))] rounded-xl border border-stone-200 p-0 shadow-lg" aria-labelledby="edit-post-title">
  <form id="edit-post-form" class="p-6" data-api-form data-method="PATCH" data-reload method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 id="edit-post-title" class="text-xl font-semibold">Edit post</h2><label class="label mt-5 block" for="edit-post-content">Post text</label><textarea class="input mt-2 min-h-32 w-full" id="edit-post-content" name="content" maxlength="5000" required></textarea><p class="form-error mt-3 hidden" data-form-error role="alert"></p><div class="mt-5 flex justify-end gap-3"><button class="button-secondary" type="button" data-close-dialog="edit-post-dialog">Cancel</button><button class="button-primary" type="submit">Save changes</button></div></form>
</dialog>
<%- include('mobile-nav') %>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js" defer></script>
<script type="module" src="/assets/app.js"></script>
</body>
</html>

