<dialog id="story-dialog" class="max-h-[calc(100dvh-1rem)] w-[min(64rem,calc(100%-1rem))] overflow-hidden rounded-sheet p-0 shadow-pop" aria-labelledby="story-dialog-title">
  <form data-api-form action="/api/stories" method="post" enctype="multipart/form-data" data-story-form class="grid max-h-[calc(100dvh-1rem)] grid-cols-[minmax(0,1fr)] overflow-y-auto md:grid-cols-[23rem_minmax(0,1fr)] md:overflow-hidden">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="textX" value="50" data-story-x>
    <input type="hidden" name="textY" value="50" data-story-y>
    <input class="sr-only" type="file" name="media" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" tabindex="-1" aria-hidden="true" data-story-file>
    <div class="order-2 flex min-h-0 flex-col border-t border-line md:order-1 md:border-r md:border-t-0">
      <div class="flex items-center justify-between px-4 pt-4"><h2 id="story-dialog-title" class="text-2xl font-bold">Your story</h2><button type="button" class="icon-btn" data-close-dialog="story-dialog" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button></div>
      <div class="min-h-0 flex-1 space-y-4 overflow-x-hidden px-4 pb-4 md:overflow-y-auto">
        <div class="mt-3 flex items-center gap-3"><%- include('avatar', { person: currentUser, size: 'size-12 text-base' }) %><span class="font-semibold"><%= currentUser.displayName %></span></div>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" class="btn-secondary" data-story-pick="image"><svg class="icon"><use href="#i-image"/></svg>Photo</button>
          <button type="button" class="btn-secondary" data-story-pick="video"><svg class="icon"><use href="#i-video"/></svg>Video</button>
        </div>
        <div>
          <div class="flex items-baseline justify-between"><label class="label" for="story-text">Text</label><span class="text-xs text-muted" data-story-count>0/250</span></div>
          <textarea id="story-text" name="text" maxlength="250" rows="3" class="input mt-2 w-full resize-none" placeholder="Start typing" data-story-text></textarea>
        </div>
        <fieldset>
          <legend class="label">Font</legend>
          <div class="scrollbar-none -mx-4 mt-2 flex gap-2 overflow-x-auto px-4 pb-1">
            <% Object.keys(STORY_FONT_LABELS).forEach(function (key, i) { %>
            <label class="relative shrink-0"><input class="peer sr-only" type="radio" name="font" value="<%= key %>" <%= i === 0 ? 'checked' : '' %>><span class="story-pill story-font-<%= key %>"><%= STORY_FONT_LABELS[key] %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset>
          <legend class="label">Text color</legend>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <% STORY_COLORS.forEach(function (color, i) { %>
            <label class="relative"><input class="peer sr-only" type="radio" name="textColor" value="<%= color %>" <%= i === 0 ? 'checked' : '' %> aria-label="Color <%= color %>"><span class="story-swatch" data-story-style="background:<%= color %>"></span></label>
            <% }) %>
            <label class="relative" title="Custom color"><input class="peer sr-only" type="radio" name="textColor" value="#ff8d28" data-story-custom-radio aria-label="Custom color"><span class="story-swatch bg-[conic-gradient(red,yellow,lime,cyan,blue,magenta,red)]" data-story-custom-swatch></span><input type="color" value="#ff8d28" class="absolute inset-0 size-8 cursor-pointer opacity-0" data-story-custom-color tabindex="-1" aria-hidden="true"></label>
          </div>
        </fieldset>
        <fieldset>
          <legend class="label">Text style</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            <% Object.keys(STORY_EFFECT_LABELS).forEach(function (key) { %>
            <label class="relative"><input class="peer sr-only" type="radio" name="textEffect" value="<%= key %>" <%= key === 'shadow' ? 'checked' : '' %>><span class="story-pill"><%= STORY_EFFECT_LABELS[key] %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <div class="flex flex-wrap items-end gap-4">
          <fieldset>
            <legend class="label">Align</legend>
            <div class="mt-2 flex gap-1.5">
              <% [['left', 'M4 6h16M4 10h10M4 14h16M4 18h10'], ['center', 'M4 6h16M7 10h10M4 14h16M7 18h10'], ['right', 'M4 6h16M10 10h10M4 14h16M10 18h10']].forEach(function (a) { %>
              <label class="relative"><input class="peer sr-only" type="radio" name="textAlign" value="<%= a[0] %>" <%= a[0] === 'center' ? 'checked' : '' %> aria-label="Align <%= a[0] %>"><span class="story-pill w-10 justify-center px-0"><svg class="icon size-[1.125rem]" viewBox="0 0 24 24"><path d="<%= a[1] %>"/></svg></span></label>
              <% }) %>
            </div>
          </fieldset>
          <div class="min-w-[9rem] flex-1">
            <label class="label" for="story-size">Size</label>
            <input id="story-size" type="range" name="textSize" min="0.5" max="2.5" step="0.05" value="1" class="mt-3 w-full accent-brand-600">
          </div>
        </div>
        <fieldset>
          <legend class="label">Animation</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            <% Object.keys(STORY_ANIMATION_LABELS).forEach(function (key) { %>
            <label class="relative"><input class="peer sr-only" type="radio" name="textAnimation" value="<%= key %>" <%= key === 'none' ? 'checked' : '' %>><span class="story-pill"><%= STORY_ANIMATION_LABELS[key] %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset data-story-bg-section>
          <legend class="label">Background</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            <% STORY_BACKGROUNDS.forEach(function (bg, i) { %>
            <label class="relative"><input class="peer sr-only" type="radio" name="background" value="<%= bg %>" <%= i === 0 ? 'checked' : '' %> aria-label="<%= bg %> background"><span class="story-swatch bg-story-<%= bg %>"></span></label>
            <% }) %>
          </div>
        </fieldset>
        <div>
          <label class="label" for="story-audience">Audience</label>
          <select id="story-audience" name="audience" class="input mt-2 h-10 w-full">
            <option value="followers" <%= (currentUser.profile && currentUser.profile.storyAudience) !== 'public' ? 'selected' : '' %>>Followers</option>
            <option value="public" <%= currentUser.profile && currentUser.profile.storyAudience === 'public' ? 'selected' : '' %>>Public</option>
          </select>
        </div>
        <p class="form-error hidden" data-form-error role="alert"></p>
      </div>
      <div class="flex gap-2 border-t border-line p-4"><button type="button" class="btn-secondary flex-1" data-story-reset>Discard</button><button type="submit" class="btn-primary flex-1">Share to story</button></div>
    </div>
    <div class="order-1 flex flex-col items-center justify-center bg-canvas p-4 md:order-2 md:p-6">
      <p class="mb-3 self-start text-15 font-semibold">Preview</p>
      <div class="story-canvas relative aspect-[9/16] w-full max-w-[13rem] touch-none select-none overflow-hidden rounded-xl bg-story-ocean shadow-float sm:max-w-[16rem] md:max-w-[min(20rem,calc((100dvh-10rem)*9/16))]" data-story-preview>
        <img class="absolute inset-0 hidden size-full object-cover" alt="" data-story-preview-image>
        <video class="absolute inset-0 hidden size-full object-cover" muted loop playsinline data-story-preview-video></video>
        <div class="absolute right-2 top-2 z-20 hidden gap-1.5" data-story-photo-actions>
          <button type="button" class="grid size-9 place-items-center rounded-full bg-surface/90 text-ink shadow-float hover:bg-surface" data-story-photo="replace" aria-label="Replace photo or video" title="Replace"><svg class="icon size-[1.125rem]"><use href="#i-edit"/></svg></button>
          <button type="button" class="grid size-9 place-items-center rounded-full bg-surface/90 text-ink shadow-float hover:bg-surface" data-story-photo="remove" aria-label="Remove photo or video" title="Remove"><svg class="icon size-[1.125rem]"><use href="#i-x"/></svg></button>
        </div>
        <p class="story-text story-font-classic story-fx-shadow story-align-center cursor-move" tabindex="0" aria-label="Story text position. Drag, or use the arrow keys, to move it." data-story-preview-text data-empty><span>Start typing</span></p>
      </div>
      <p class="mt-3 flex items-center gap-2 text-[0.8125rem] text-muted"><svg class="icon size-4"><use href="#i-move"/></svg>Drag the text to move it.<button type="button" class="font-semibold text-brand-600 hover:underline" data-story-center>Center</button></p>
    </div>
  </form>
</dialog>
<% } %>

<%- include('mobile-nav') %>
<%# Served by the attached Socket.IO server so realtime never depends on a third-party CDN. %>
<script src="/socket.io/socket.io.js" defer></script>
<script type="module" src="/assets/app.js?v=<%= assetVersion %>"></script>
</body>
</html>
