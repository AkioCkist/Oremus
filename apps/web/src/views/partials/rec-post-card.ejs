<%# Suggested post tile (home rail, For you grid). Locals: post (RecPost), fluid (fill the grid cell instead of a fixed rail width). -%>
<% const p = locals.post; const fluid = !!locals.fluid; -%>
<a href="/posts/<%= p._id %>" class="tile group/rec <%= fluid ? 'w-full min-w-0' : 'w-40 shrink-0 snap-start sm:rounded-lg' %>" aria-label="Suggested post by <%= p.author.displayName %>. <%= p.reason.text %>" title="<%= p.reason.text %>">
  <% if (p.media && p.media.url) { %>
  <img src="<%= p.media.url %>" alt="" loading="lazy" decoding="async">
  <% } else if (p.media) { %>
  <span class="grid size-full place-items-center text-muted"><svg class="icon size-8"><use href="#i-video"/></svg></span>
  <% } else { %>
  <span class="flex size-full items-center justify-center bg-field p-3 text-center"><span class="line-clamp-6 whitespace-pre-line break-words font-display text-subheadline font-medium sm:text-callout"><%= p.content %></span></span>
  <% } %>
  <span class="tile-shade"><span class="tile-stat"><svg class="icon size-5 fill-current"><use href="#i-heart"/></svg><%= compact(p.reactionCount || 0) %></span><span class="tile-stat"><svg class="icon size-5 fill-current"><use href="#i-comment"/></svg><%= compact(p.commentCount || 0) %></span></span>
  <% if (p.media && p.media.video) { %><svg class="icon absolute right-2 top-2 size-5 fill-current text-white drop-shadow"><use href="#i-play"/></svg><% } else if (p.mediaCount > 1) { %><svg class="icon absolute right-2 top-2 size-5 text-white drop-shadow"><use href="#i-stories"/></svg><% } %>
  <% if (p.media) { %>
  <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-1.5 bg-gradient-to-t from-black/60 to-transparent p-2 pt-8 text-white">
    <%- include('avatar', { person: p.author, size: 'size-5 text-[0.5rem]' }) %>
    <span class="truncate text-caption1 font-medium"><%= p.author.displayName %></span>
  </span>
  <% } %>
</a>
