<%# Square profile media tile (photo or video) that opens the viewer; owners also get the options menu. -%>
<% const label = item.isVideo ? 'video' : 'photo'; -%>
<div data-key="<%= item.mediaId %>" class="tile group/photo">
  <button type="button" class="block size-full" data-lightbox="<%= item.url %>" data-post="<%= item.postId %>" aria-label="Open <%= label %>">
    <% if (item.isVideo) { %>
      <% if (item.poster) { %><img src="<%= item.poster %>" alt="" loading="lazy"><% } else { %><video class="pointer-events-none" src="<%= item.url %>#t=0.1" muted playsinline preload="metadata" tabindex="-1" aria-hidden="true"></video><% } %>
      <svg class="icon pointer-events-none absolute right-2 top-2 size-5 fill-current text-white drop-shadow"><use href="#i-play"/></svg>
      <% if (item.status === 'processing') { %><span class="pointer-events-none absolute bottom-1.5 left-1.5 rounded-full bg-black/65 px-2 py-0.5 text-2xs font-semibold text-white">Processing…</span><% } else if (item.status === 'failed') { %><span class="pointer-events-none absolute bottom-1.5 left-1.5 rounded-full bg-ios-red px-2 py-0.5 text-2xs font-semibold text-white">Failed</span><% } %>
    <% } else { %>
      <img src="<%= item.url %>" alt="<%= item.alt || '' %>" loading="lazy">
    <% } %>
  <span class="tile-shade"><span class="tile-stat"><svg class="icon size-5 fill-current"><use href="#i-heart"/></svg><%= compact(item.reactionCount || 0) %></span><span class="tile-stat"><svg class="icon size-5 fill-current"><use href="#i-comment"/></svg><%= compact(item.commentCount || 0) %></span></span></button>
  <% if (isSelf) { %><button type="button" class="glass absolute bottom-1.5 right-1.5 grid size-8 place-items-center rounded-full text-ink transition-opacity sm:opacity-0 sm:group-hover/photo:opacity-100 sm:focus-visible:opacity-100" data-photo-menu="post" data-post="<%= item.postId %>" data-media="<%= item.mediaId %>" data-url="<%= item.url %>" aria-label="<%= item.isVideo ? 'Video' : 'Photo' %> options"><svg class="icon size-[1.125rem]"><use href="#i-more"/></svg></button><% } %>
</div>
