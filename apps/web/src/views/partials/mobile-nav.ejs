<% if (typeof currentUser !== 'undefined' && currentUser && !locals.hideMobileNav) { const on = (href) => href === '/' ? path === '/' : path.startsWith(href); %>
<nav aria-label="Mobile navigation" class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t border-line bg-white px-1 pb-[max(.375rem,env(safe-area-inset-bottom))] pt-1.5 md:hidden">
  <a class="mobile-link <%= on('/') ? 'mobile-link-active' : '' %>" href="/"><svg class="icon size-6"><use href="#i-home"/></svg>Home</a>
  <a class="mobile-link <%= on('/stories') ? 'mobile-link-active' : '' %>" href="/stories"><svg class="icon size-6"><use href="#i-stories"/></svg>Stories</a>
  <a class="mobile-link <%= on('/groups') ? 'mobile-link-active' : '' %>" href="/groups"><svg class="icon size-6"><use href="#i-group"/></svg>Groups</a>
  <a class="mobile-link <%= on('/messages') ? 'mobile-link-active' : '' %>" href="/messages"><svg class="icon size-6"><use href="#i-chat"/></svg>Chats<% if (locals.unreadMessages) { %><span class="badge right-[calc(50%-1.25rem)] top-0"><%= unreadMessages %></span><% } %></a>
  <a class="mobile-link <%= on('/notifications') ? 'mobile-link-active' : '' %>" href="/notifications"><svg class="icon size-6"><use href="#i-bell"/></svg>Alerts<% if (locals.unreadNotifications) { %><span class="badge right-[calc(50%-1.25rem)] top-0"><%= unreadNotifications %></span><% } %></a>
</nav>
<% } %>
