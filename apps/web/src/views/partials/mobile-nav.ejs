<% if (typeof currentUser !== 'undefined' && currentUser && !locals.hideMobileNav) { const on = (href) => href === '/' ? path === '/' : path.startsWith(href); const meHref = `/profile/${currentUser.username}`; const onMe = path === meHref; %>
<%# Kit: Tab Bar - iPhone, four tabs plus the detached search circle. -%>
<nav aria-label="Mobile navigation" class="mobile-tabbar">
  <div class="mobile-tabs">
    <a class="mobile-link <%= on('/') ? 'mobile-link-active' : '' %>" href="/"><svg class="icon size-6"><use href="#i-home<%= on('/') ? '-fill' : '' %>"/></svg>Home</a>
    <a class="mobile-link <%= on('/discover') ? 'mobile-link-active' : '' %>" href="/discover"><svg class="icon size-6"><use href="#i-compass<%= on('/discover') ? '-fill' : '' %>"/></svg>For you</a>
    <a class="mobile-link <%= on('/messages') ? 'mobile-link-active' : '' %>" href="/messages" data-badge-link="messages" data-badge-class="right-[calc(50%-1.375rem)] top-1"><svg class="icon size-6"><use href="#i-chat<%= on('/messages') ? '-fill' : '' %>"/></svg>Chats<% if (locals.unreadMessages) { %><span class="badge right-[calc(50%-1.375rem)] top-1" data-badge><%= unreadMessages > 9 ? '9+' : unreadMessages %></span><% } %></a>
    <a class="mobile-link <%= onMe ? 'mobile-link-active' : '' %>" href="<%= meHref %>"><svg class="icon size-6"><use href="#i-user<%= onMe ? '-fill' : '' %>"/></svg>Profile</a>
  </div>
  <a class="mobile-search" href="/search" aria-label="Search"><svg class="icon size-6"><use href="#i-search"/></svg></a>
</nav>
<% } %>
