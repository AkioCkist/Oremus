<%# Facebook-style story rail. Locals: tray (TrayGroup[]). -%>
<% const groups = locals.tray || []; const mine = groups.find(function (g) { return g.isSelf; }); const others = groups.filter(function (g) { return !g.isSelf; }); -%>
<section class="relative" aria-label="Stories">
  <div class="scrollbar-none flex snap-x scroll-px-4 gap-2 overflow-x-auto px-4 sm:scroll-px-0 sm:px-0" data-story-rail>
    <!-- Create story -->
    <button type="button" class="story-card group snap-start bg-white text-left after:hidden" data-open-story-composer>
      <span class="block h-[74%] overflow-hidden">
        <% if (currentUser.profile && currentUser.profile.avatarUrl) { %><img class="story-thumb" src="<%= currentUser.profile.avatarUrl %>" alt=""><% } else { %><span class="grid size-full place-items-center <%= toneOf(currentUser.displayName) %> font-display text-4xl font-bold text-white"><%= initials(currentUser.displayName) %></span><% } %>
      </span>
      <span class="absolute left-1/2 top-[74%] z-10 grid size-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-brand-600 text-white ring-4 ring-white"><svg class="icon"><use href="#i-plus"/></svg></span>
      <span class="absolute inset-x-0 bottom-0 grid h-[26%] place-items-end justify-center bg-white pb-2.5 text-[0.8125rem] font-semibold text-ink">Create story</span>
    </button>
    <% if (mine) { const last = mine.stories[mine.stories.length - 1]; %>
    <a class="story-card snap-start" href="/stories/<%= mine.author.username %>" aria-label="Your story">
      <% if (last.mediaUrl) { %><img class="story-thumb" src="<%= last.mediaUrl %>" alt=""><% } else { %><span class="grid size-full place-items-center bg-story-<%= last.background %> p-3 text-center font-display text-sm font-bold text-white"><%= last.text.slice(0, 60) %></span><% } %>
      <span class="absolute left-3 top-3 z-10"><%- include('avatar', { person: mine.author, size: 'size-8 text-xs', ring: 'seen' }) %></span>
      <span class="text-shadow absolute inset-x-3 bottom-2.5 z-10 truncate text-[0.8125rem] font-semibold text-white">Your story</span>
    </a>
    <% } %>
    <% others.forEach(function (g) { const cover = g.stories[g.startIndex] || g.stories[0]; %>
    <a class="story-card snap-start" href="/stories/<%= g.author.username %>" aria-label="<%= g.author.displayName %>'s story<%= g.hasUnseen ? ', new' : '' %>">
      <% if (cover.mediaUrl) { %><img class="story-thumb" src="<%= cover.mediaUrl %>" alt="" loading="lazy"><% } else { %><span class="grid size-full place-items-center bg-story-<%= cover.background %> p-3 text-center font-display text-sm font-bold text-white"><%= cover.text.slice(0, 60) %></span><% } %>
      <span class="absolute left-3 top-3 z-10"><%- include('avatar', { person: g.author, size: 'size-8 text-xs', ring: g.hasUnseen ? 'unseen' : 'seen' }) %></span>
      <span class="text-shadow absolute inset-x-3 bottom-2.5 z-10 line-clamp-2 text-[0.8125rem] font-semibold leading-tight text-white"><%= g.author.displayName %></span>
    </a>
    <% }) %>
  </div>
  <% if (others.length > 3) { %>
  <button type="button" class="icon-btn-float absolute right-3 top-1/2 z-10 hidden -translate-y-1/2 sm:grid" data-scroll-rail aria-label="See more stories"><svg class="icon"><use href="#i-chevron-right"/></svg></button>
  <% } %>
</section>
