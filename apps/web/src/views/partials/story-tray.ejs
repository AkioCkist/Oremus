<%# Story circles. Locals: tray (TrayGroup[]), suggestedStories (RecStory[]: public stories from people you don't follow, ranked by the recommender). -%>
<% const groups = locals.tray || []; const mine = groups.find(function (g) { return g.isSelf; }); const others = groups.filter(function (g) { return !g.isSelf; }); const suggested = locals.suggestedStories || []; -%>
<section class="relative" aria-label="Stories">
  <div class="story-tray" data-story-rail>
    <div class="story-item">
      <% if (mine) { %>
      <a class="contents" href="/stories/<%= mine.author.username %>" aria-label="Your story">
        <%- include('avatar', { person: mine.author, size: 'size-[4.125rem] text-xl', ring: mine.hasUnseen ? 'unseen' : 'seen' }) %>
        <span class="story-item-name">Your story</span>
      </a>
      <% } else { %>
      <button type="button" class="contents" data-open-story-composer aria-label="Add to your story">
        <%- include('avatar', { person: currentUser, size: 'size-[4.125rem] text-xl', ring: 'seen' }) %>
        <span class="story-item-name">Your story</span>
      </button>
      <% } %>
      <button type="button" class="story-plus" data-open-story-composer aria-label="Add to your story"><svg class="icon size-3.5 [stroke-width:3]"><use href="#i-plus"/></svg></button>
    </div>
    <% others.forEach(function (g) { %>
    <a class="story-item" href="/stories/<%= g.author.username %>" aria-label="<%= g.author.displayName %>'s story<%= g.hasUnseen ? ', new' : '' %>">
      <%- include('avatar', { person: g.author, size: 'size-[4.125rem] text-xl', ring: g.hasUnseen ? 'unseen' : 'seen' }) %>
      <span class="story-item-name"><%= firstName(g.author.displayName) %></span>
    </a>
    <% }) %>
    <% suggested.forEach(function (s) { %>
    <a class="story-item" href="/stories/<%= s.author.username %>" aria-label="Suggested story from <%= s.author.displayName %>. <%= s.reason.text %>" title="<%= s.reason.text %>" data-suggested-story>
      <%- include('avatar', { person: s.author, size: 'size-[4.125rem] text-xl', ring: s.seen ? 'seen' : 'unseen' }) %>
      <span class="story-item-name flex items-center justify-center gap-0.5"><svg class="icon size-3 shrink-0 text-muted" aria-label="Suggested"><use href="#i-sparkles"/></svg><span class="truncate"><%= firstName(s.author.displayName) %></span></span>
    </a>
    <% }) %>
  </div>
  <% if (others.length + suggested.length > 6) { %>
  <button type="button" class="icon-btn-float absolute right-1 top-7 z-10 hidden size-8 sm:grid" data-scroll-rail aria-label="See more stories"><svg class="icon size-4"><use href="#i-chevron-right"/></svg></button>
  <% } %>
</section>
