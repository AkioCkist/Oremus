<header class="sticky top-0 z-30 border-b border-stone-200 bg-white/95">
  <div class="mx-auto flex h-16 max-w-screen-2xl items-center gap-4 px-4 lg:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 font-bold text-accent-700" aria-label="Oremus home">
      <span class="grid size-9 place-items-center rounded-full bg-accent-600 text-lg text-white" aria-hidden="true">O</span><span class="hidden sm:inline">Oremus</span>
    </a>
    <% if (currentUser) { %>
    <form action="/search" method="get" role="search" class="mx-auto max-w-md flex-1">
      <label for="site-search" class="sr-only">Search Oremus</label>
      <input id="site-search" name="q" type="search" placeholder="Search people, posts, groups" class="input w-full" value="<%= typeof q !== 'undefined' ? q : '' %>">
    </form>
    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      <a class="nav-link <%= path === '/' ? 'nav-active' : '' %>" href="/">Home</a>
      <a class="nav-link <%= path.startsWith('/groups') ? 'nav-active' : '' %>" href="/groups">Groups</a>
      <a class="nav-link <%= path.startsWith('/messages') ? 'nav-active' : '' %>" href="/messages">Messages</a>
      <a class="nav-link <%= path === '/notifications' ? 'nav-active' : '' %>" href="/notifications">Alerts</a>
    </nav>
    <a class="avatar size-9" href="/profile/<%= currentUser.username %>" aria-label="Open your profile"><% if (currentUser.profile?.avatarUrl) { %><img src="<%= currentUser.profile.avatarUrl %>" alt=""><% } else { %><%= currentUser.displayName.charAt(0) %><% } %></a>
    <% } %>
  </div>
</header>

