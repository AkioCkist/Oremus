<%- include('../partials/head') %><%- include('../partials/nav') %><main id="main" class="mx-auto max-w-6xl px-4 py-6 pb-24"><section class="card overflow-hidden"><div class="h-48 bg-stone-200 sm:h-72"><% if (group.coverUrl) { %><img class="size-full object-cover" src="<%= group.coverUrl %>" alt="<%= group.name %> cover"><% } %></div><div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow"><%= group.privacy %> group</p><h1 class="mt-1 text-balance text-3xl font-bold"><%= group.name %></h1><p class="mt-2 max-w-3xl text-pretty text-stone-600"><%= group.description %></p><p class="mt-3 text-sm text-stone-500"><%= group.memberCount %> members</p></div><% if (currentUser && !member && !pending) { %><button class="button-primary" data-group-join="<%= group._id %>">Request to join</button><% } else if (pending) { %><span class="rounded-md bg-stone-100 px-3 py-2 text-sm font-medium text-stone-600">Request pending</span><% } %></div></section><div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]"><section class="space-y-5"><% if (member) { %><section class="card p-4"><form data-api-form data-reset data-reload action="/api/posts" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="groupId" value="<%= group._id %>"><input type="hidden" name="visibility" value="public"><label class="sr-only" for="group-post">Post in group</label><textarea class="input min-h-20 w-full" id="group-post" name="content" placeholder="Share with <%= group.name %>"></textarea><div class="mt-3 flex justify-between"><label class="button-secondary cursor-pointer">Add images<input class="sr-only" name="images" type="file" accept="image/*" multiple></label><button class="button-primary" type="submit">Publish</button></div><p class="form-error hidden" data-form-error role="alert"></p></form></section><% } %><% if (posts.length) { posts.forEach(function(item) { %><%- include('../partials/post-card', { item }) %><% }) } else { %><div class="empty-state"><h2 class="font-semibold">No posts in this group yet</h2><p class="mt-2 text-stone-600"><%= member ? 'Start the first conversation.' : 'Join the group to take part.' %></p></div><% } %></section><aside><% if (requests.length) { %><section class="card p-5"><h2 class="font-semibold">Join requests</h2><ul class="mt-4 space-y-4"><% requests.forEach(function(request) { %><li><p class="font-medium"><%= request.userId.displayName %></p><p class="text-sm text-stone-500">@<%= request.userId.username %></p><div class="mt-2 flex gap-2"><button class="button-primary px-3 py-1.5 text-sm" data-group-decision="approve" data-request="<%= request._id %>">Approve</button><button class="button-secondary px-3 py-1.5 text-sm" data-group-decision="reject" data-request="<%= request._id %>">Reject</button></div></li><% }) %></ul></section><% } %></aside></div></main><%- include('../partials/foot') %>

