<%- include('../partials/head') %><%- include('../partials/nav') %>
<main id="main" <%= locals.openCreate ? 'data-open-create-group' : '' %> class="grid min-h-[calc(100dvh-3.5rem)] lg:grid-cols-[22.5rem_minmax(0,1fr)]">
  <!-- Groups sidebar -->
  <aside class="border-r border-line bg-surface lg:sticky lg:top-14 lg:h-[calc(100dvh-3.5rem)] lg:overflow-y-auto" aria-label="Groups navigation">
    <div class="p-4">
      <h1 class="font-display text-2xl font-extrabold">Groups</h1>
      <div class="relative mt-3">
        <label class="sr-only" for="group-filter">Search groups</label>
        <svg class="icon pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted"><use href="#i-search"/></svg>
        <input id="group-filter" type="search" class="pill-input pl-9" placeholder="Search groups" data-group-filter autocomplete="off">
      </div>
      <nav class="mt-3 space-y-0.5" aria-label="Group views">
        <a class="side-link bg-brand-50 text-brand-700 hover:bg-brand-50" href="/groups" aria-current="page"><span class="grid size-9 place-items-center rounded-full bg-brand-600 text-white"><svg class="icon"><use href="#i-feed"/></svg></span>Discover</a>
      </nav>
      <% if (currentUser) { %><button class="btn-soft mt-3 w-full" type="button" data-open-group-dialog><svg class="icon"><use href="#i-plus"/></svg>Create new group</button><% } %>
      <% if (myGroups.length) { %>
      <div class="divider mt-4"></div>
      <h2 class="pb-1 pt-2 text-[1.0625rem] font-bold">Groups you've joined</h2>
      <ul class="space-y-0.5">
        <% myGroups.forEach(function (g) { %>
        <li><a class="side-link" href="/groups/<%= g.slug %>">
          <span class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-lg <%= g.coverUrl ? 'bg-field' : toneOf(g.name) %>"><% if (g.coverUrl) { %><img class="size-full object-cover" src="<%= g.coverUrl %>" alt=""><% } else { %><span class="font-display font-bold text-white"><%= initials(g.name) %></span><% } %></span>
          <span class="min-w-0"><span class="block truncate font-semibold"><%= g.name %></span><span class="block text-[0.8125rem] font-normal text-muted"><%= plural(g.memberCount, 'member') %></span></span>
        </a></li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </aside>

  <!-- Discover -->
  <section class="px-3 py-5 pb-24 sm:px-6 lg:px-10" aria-labelledby="discover-title">
    <div class="mx-auto max-w-6xl">
      <h2 id="discover-title" class="text-xl font-bold">Suggested for you</h2>
      <p class="text-15 text-muted">Groups you might be interested in.</p>
      <% if (groups.length) { %>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-group-grid>
        <% groups.forEach(function (g) { %>
        <li class="card flex flex-col overflow-hidden" data-group-name="<%= g.name.toLowerCase() %>">
          <a href="/groups/<%= g.slug %>" class="block aspect-[16/7] overflow-hidden bg-field"><img class="size-full object-cover transition-transform duration-300 hover:scale-[1.03]" src="<%= g.coverUrl || '/assets/img/default-cover.svg' %>" alt="" loading="lazy"></a>
          <div class="flex flex-1 flex-col p-4">
            <h3 class="text-[1.0625rem] font-bold leading-snug"><a class="hover:underline" href="/groups/<%= g.slug %>"><%= g.name %></a></h3>
            <p class="mt-0.5 flex items-center gap-1 text-[0.8125rem] text-muted"><svg class="icon size-3.5"><use href="#<%= g.visibility === 'hidden' ? 'i-eye-off' : g.privacy === 'private' ? 'i-lock' : 'i-globe' %>"/></svg><%= g.visibility === 'hidden' ? 'Hidden' : g.privacy === 'private' ? 'Private' : 'Public' %> group · <%= plural(g.memberCount, 'member') %></p>
            <% if (g.tags && g.tags.length) { %><div class="mt-2 flex flex-wrap gap-1"><% g.tags.slice(0, 3).forEach(function (tag) { %><span class="rounded-full bg-field px-2 py-0.5 text-xs font-medium text-muted">#<%= tag %></span><% }) %></div><% } %>
            <% if (g.description) { %><p class="mt-2 line-clamp-2 text-15 text-muted"><%= g.description %></p><% } %>
            <div class="mt-auto pt-4">
              <% if (g.isMember) { %><a class="btn-secondary w-full" href="/groups/<%= g.slug %>">View group</a>
              <% } else if (currentUser) { %><a class="btn-soft w-full" href="/groups/<%= g.slug %>"><%= g.privacy === 'private' ? 'Request to join' : 'Join group' %></a>
              <% } else { %><a class="btn-soft w-full" href="/login">Log in to join</a><% } %>
            </div>
          </div>
        </li>
        <% }) %>
      </ul>
      <p class="mt-6 hidden text-center text-muted" data-group-empty>No groups match your search.</p>
      <% } else { %>
      <div class="empty-state mt-4"><div class="empty-icon"><svg class="icon size-7"><use href="#i-group"/></svg></div><h3 class="mt-4 text-lg font-bold">No groups yet</h3><p class="mt-1 text-muted">Start the first community on Oremus.</p></div>
      <% } %>
    </div>
  </section>
</main>

<% if (currentUser) { %><%- include('_dialogs', { formMode: 'create', group: null }) %><% } %>
<%- include('../partials/foot') %>
