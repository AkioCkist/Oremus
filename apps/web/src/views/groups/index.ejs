<%- include('../partials/head') %><%- include('../partials/nav') %>
<main id="main" <%= locals.openCreate ? 'data-open-create-group' : '' %> class="wide-shell">
  <header class="flex flex-wrap items-center gap-3 px-4 pb-5 pt-4 lg:px-0 lg:pt-8">
    <h1 class="page-title mr-auto">Groups</h1>
    <div class="relative w-full sm:w-72">
      <label class="sr-only" for="group-filter">Search groups</label>
      <svg class="icon pointer-events-none absolute left-3.5 top-1/2 size-[1.125rem] -translate-y-1/2 text-muted"><use href="#i-search"/></svg>
      <input id="group-filter" type="search" class="pill-input h-11 pl-10" placeholder="Search groups" data-group-filter autocomplete="off">
    </div>
    <% if (currentUser) { %><button class="btn-primary h-11 px-5" type="button" data-open-group-dialog><svg class="icon"><use href="#i-plus"/></svg>New group</button><% } %>
  </header>

  <% if (myGroups.length) { %>
  <section aria-labelledby="my-groups-title" class="pb-7">
    <h2 id="my-groups-title" class="section-title px-4 lg:px-0">Your groups</h2>
    <ul class="scrollbar-none mt-3 flex gap-4 overflow-x-auto px-4 lg:px-0">
      <% myGroups.forEach(function (g) { %>
      <li class="w-[5.5rem] shrink-0">
        <a class="block text-center" href="/groups/<%= g.slug %>">
          <span class="press-lift mx-auto grid size-[4.5rem] place-items-center overflow-hidden rounded-[1.125rem] <%= g.coverUrl ? 'bg-field' : toneOf(g.name) %>"><% if (g.coverUrl) { %><img class="size-full object-cover" src="<%= g.coverUrl %>" alt="" loading="lazy"><% } else { %><span class="font-display text-title3 font-semibold text-white"><%= initials(g.name) %></span><% } %></span>
          <span class="mt-1.5 line-clamp-2 text-caption1 leading-tight"><%= g.name %></span>
        </a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <section aria-labelledby="discover-title">
    <h2 id="discover-title" class="section-title px-4 lg:px-0">Discover</h2>
    <% if (groups.length) { %>
    <ul class="mt-3 grid gap-3 px-3 sm:grid-cols-2 lg:px-0 xl:grid-cols-3" data-group-grid data-infinite="groups" data-infinite-next="<%= groupsNext || '' %>">
      <%- include('../partials/chunks/groups', { items: groups }) %>
    </ul>
    <p class="mt-6 hidden text-center text-muted" data-group-empty>No groups match your search.</p>
    <% } else { %>
    <div class="empty-state"><div class="empty-icon"><svg class="icon size-7"><use href="#i-group"/></svg></div><h3 class="mt-4 text-title3 font-semibold">No groups yet</h3><p class="mt-1 text-subheadline text-muted">Start the first community on Oremus.</p></div>
    <% } %>
  </section>
</main>

<% if (currentUser) { %><%- include('_dialogs', { formMode: 'create', group: null }) %><% } %>
<%- include('../partials/foot') %>
