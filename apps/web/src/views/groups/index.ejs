<%- include('../partials/head') %><%- include('../partials/nav') %><main id="main" class="mx-auto max-w-6xl px-4 py-8 pb-24"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="eyebrow">Communities</p><h1 class="mt-2 text-balance text-3xl font-bold">Find your people</h1><p class="mt-2 text-pretty text-stone-600">Join focused spaces built around shared interests.</p></div><% if (currentUser) { %><button class="button-primary" data-toggle="create-group">Create a group</button><% } %></div><section id="create-group" class="card mt-6 hidden p-5"><h2 class="text-lg font-semibold">New group</h2><form class="mt-4 grid gap-4 sm:grid-cols-2" data-api-form action="/api/groups" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label" for="group-name">Name</label><input class="input mt-2 w-full" id="group-name" name="name" required maxlength="80"></div><div><label class="label" for="privacy">Privacy</label><select class="input mt-2 w-full" id="privacy" name="privacy"><option value="public">Public</option><option value="private">Private</option></select></div><div class="sm:col-span-2"><label class="label" for="description">Description</label><textarea class="input mt-2 w-full" id="description" name="description" maxlength="500"></textarea></div><p class="form-error hidden sm:col-span-2" data-form-error role="alert"></p><button class="button-primary sm:col-span-2 sm:justify-self-start" type="submit">Create group</button></form></section><section class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% groups.forEach(function(group) { %><article class="card overflow-hidden"><div class="h-28 bg-stone-200"><% if (group.coverUrl) { %><img class="size-full object-cover" src="<%= group.coverUrl %>" alt=""><% } %></div><div class="p-5"><p class="text-xs font-semibold uppercase text-accent-700"><%= group.privacy %> group</p><h2 class="mt-2 text-xl font-semibold"><a class="hover:underline" href="/groups/<%= group.slug %>"><%= group.name %></a></h2><p class="mt-2 line-clamp-3 text-pretty text-sm text-stone-600"><%= group.description %></p><p class="mt-4 text-sm text-stone-500"><%= group.memberCount %> members<%= group.isMember ? ' · Joined' : '' %></p></div></article><% }) %></section></main><%- include('../partials/foot') %>

