<%- include('partials/head') %><%- include('partials/nav') %>
<% const info = currentUser.profile || {}; -%>
<main id="main" data-smooth-scroll class="grid min-h-[calc(100dvh-var(--header-h))] grid-cols-1 lg:grid-cols-[22.5rem_minmax(0,1fr)]">
  <aside class="border-b border-line bg-surface lg:sticky lg:top-[var(--header-h)] lg:h-[calc(100dvh-var(--header-h))] lg:border-b-0 lg:border-r" aria-label="Settings sections">
    <div class="p-4">
      <div class="flex items-center gap-3">
        <h1 class="page-title">Settings</h1>
      </div>
      <nav class="mt-3 flex gap-1 overflow-x-auto lg:flex-col" aria-label="Settings">
        <a class="side-link shrink-0" href="#profile"><span class="tile-icon bg-ios-blue"><svg class="icon"><use href="#i-user"/></svg></span>Profile</a>
        <a class="side-link shrink-0" href="#photos"><span class="tile-icon bg-ios-orange"><svg class="icon"><use href="#i-camera"/></svg></span>Photos</a>
        <a class="side-link shrink-0" href="#privacy"><span class="tile-icon bg-subtle"><svg class="icon"><use href="#i-shield"/></svg></span>Privacy</a>
        <a class="side-link shrink-0" href="#display"><span class="tile-icon bg-ios-indigo"><svg class="icon"><use href="#i-moon"/></svg></span>Display</a>
        <a class="side-link shrink-0" href="#interests"><span class="tile-icon bg-ios-purple"><svg class="icon"><use href="#i-sparkles"/></svg></span>Interests</a>
        <a class="side-link shrink-0" href="#ads"><span class="tile-icon bg-ios-green"><svg class="icon"><use href="#i-megaphone"/></svg></span>Ads</a>
        <a class="side-link shrink-0" href="#safety"><span class="tile-icon bg-ios-red"><svg class="icon"><use href="#i-flag"/></svg></span>Account status</a>
        <a class="side-link shrink-0" href="#stories"><span class="tile-icon bg-ios-pink"><svg class="icon"><use href="#i-stories"/></svg></span>Stories</a>
        <a class="side-link shrink-0" href="#session"><span class="tile-icon bg-ios-teal"><svg class="icon"><use href="#i-key"/></svg></span>Session</a>
      </nav>
    </div>
  </aside>

  <section class="bg-grouped px-3 py-5 pb-24 sm:px-6 lg:py-10">
    <div class="mx-auto max-w-2xl space-y-4">
      <section id="profile" class="card scroll-mt-20 overflow-hidden">
        <div class="flex flex-wrap items-center gap-4 p-5">
          <div class="relative"><%- include('partials/avatar', { person: currentUser, size: 'size-20 text-2xl' }) %><button type="button" class="icon-btn absolute -bottom-1 -right-1 size-9" data-pick-photo-kind="avatar" aria-label="Update profile picture"><svg class="icon size-[1.125rem]"><use href="#i-camera"/></svg></button></div>
          <div class="min-w-0 flex-1"><h2 class="truncate text-title3 font-semibold"><%= currentUser.displayName %></h2><p class="truncate text-15 text-muted">@<%= currentUser.username %><%= info.location ? ' · ' + info.location : '' %></p></div>
          <div class="flex gap-2"><button type="button" class="btn-primary" data-open-dialog="edit-profile-dialog"><svg class="icon"><use href="#i-edit"/></svg>Edit profile</button><a class="btn-secondary" href="/profile/<%= currentUser.username %>">View profile</a></div>
        </div>
      </section>
      <section id="photos" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Photos</h2>
        <p class="mt-1 text-15 text-muted">Pick from your uploads and previous photos, or upload a new one.</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          <button type="button" class="flex items-center gap-3 rounded-lg p-2 text-left hover:bg-hover" data-pick-photo-kind="avatar"><span class="icon-btn"><svg class="icon"><use href="#i-user"/></svg></span><span><span class="block font-semibold">Profile picture</span><span class="block text-[0.8125rem] text-muted">Choose or upload</span></span></button>
        </div>
      </section>
      <section id="privacy" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Privacy</h2>
        <form class="mt-3 flex flex-wrap items-end gap-3" data-api-form data-method="PATCH" action="/api/profile/details" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="min-w-[14rem] flex-1"><label class="label" for="privacy-select">Who can see your profile details</label><select class="input mt-1.5 w-full" id="privacy-select" name="privacy"><option value="public" <%= info.privacy !== 'followers' ? 'selected' : '' %>>Public — anyone on Oremus</option><option value="followers" <%= info.privacy === 'followers' ? 'selected' : '' %>>Followers only</option></select></div>
          <button class="btn-secondary" type="submit">Save</button>
          <p class="form-error hidden w-full" data-form-error role="alert"></p>
        </form>
      </section>

      <section id="display" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Display</h2>
        <p class="mt-1 text-15 text-muted">Adjust the appearance of Oremus to reduce glare and give your eyes a break.</p>
        <fieldset class="mt-4 space-y-2">
          <legend class="label mb-2">Dark mode</legend>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl p-2 hover:bg-hover">
            <span class="icon-btn shrink-0"><svg class="icon"><use href="#i-sun"/></svg></span>
            <span class="flex-1"><span class="block font-semibold">Off</span><span class="block text-[0.8125rem] text-muted">Bright background with dark text.</span></span>
            <input type="radio" name="theme" value="light" class="check size-5" data-theme-choice <%= theme === 'light' ? 'checked' : '' %>>
          </label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl p-2 hover:bg-hover">
            <span class="icon-btn shrink-0"><svg class="icon"><use href="#i-moon"/></svg></span>
            <span class="flex-1"><span class="block font-semibold">On</span><span class="block text-[0.8125rem] text-muted">Dark background that is easier on the eyes at night.</span></span>
            <input type="radio" name="theme" value="dark" class="check size-5" data-theme-choice <%= theme === 'dark' ? 'checked' : '' %>>
          </label>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl p-2 hover:bg-hover">
            <span class="icon-btn shrink-0"><svg class="icon"><use href="#i-monitor"/></svg></span>
            <span class="flex-1"><span class="block font-semibold">Automatic</span><span class="block text-[0.8125rem] text-muted">Match your device's display settings.</span></span>
            <input type="radio" name="theme" value="system" class="check size-5" data-theme-choice <%= theme === 'system' ? 'checked' : '' %>>
          </label>
        </fieldset>
        <p class="mt-3 text-[0.8125rem] text-muted">Saved on this device. You can also switch quickly from the account menu.</p>
      </section>

      <section id="interests" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Interests</h2>
        <% const myInterests = (currentUser.interests && currentUser.interests.completedAt) ? currentUser.interests.topics || [] : []; %>
        <p class="mt-1 text-15 text-muted"><%= myInterests.length ? `${myInterests.length} interests picked. They shape the people, posts, groups and stories suggested to you.` : 'Tell us what you like to get better suggestions for people, posts, groups and stories.' %></p>
        <div class="mt-4 flex flex-wrap gap-2"><a class="btn-primary" href="/onboarding?next=/settings%23interests"><svg class="icon"><use href="#i-sparkles"/></svg><%= myInterests.length ? 'Edit interests' : 'Choose interests' %></a><a class="btn-secondary" href="/discover">See suggestions</a></div>
      </section>

      <section id="ads" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Ads</h2>
        <p class="mt-1 text-15 text-muted">Choose what you'd rather not see. Ads never use your private messages.</p>
        <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-lg border border-line p-3">
          <input type="checkbox" class="check mt-1 shrink-0" data-ad-personalized <%= adPreferences.personalized ? 'checked' : '' %>>
          <span><span class="block font-semibold">Use my interests</span><span class="mt-1 block text-pretty text-sm text-muted">Show ads related to the interests you picked. Turned off, you still see ads, but they aren't chosen for you.</span></span>
        </label>
        <h3 class="mt-4 text-15 font-semibold">Advertisers you've stopped</h3>
        <% if (adPreferences.blockedAdvertisers.length) { %>
        <ul class="mt-2 divide-y divide-line">
          <% adPreferences.blockedAdvertisers.forEach(function (person) { %><li class="flex items-center justify-between gap-3 py-2"><span class="min-w-0 truncate text-15"><%= person.name %></span><button type="button" class="btn-secondary shrink-0" data-ad-undo="unblock_advertiser" data-ad-value="<%= person.id %>">Allow again</button></li><% }) %>
        </ul>
        <% } else { %><p class="mt-1 text-15 text-muted">None. Use the menu on any ad to stop an advertiser.</p><% } %>
        <h3 class="mt-4 text-15 font-semibold">Topics you've turned off</h3>
        <% if (adPreferences.blockedTopics.length) { %>
        <ul class="mt-2 divide-y divide-line">
          <% adPreferences.blockedTopics.forEach(function (topic) { %><li class="flex items-center justify-between gap-3 py-2"><span class="min-w-0 truncate text-15"><%= topic.label %></span><button type="button" class="btn-secondary shrink-0" data-ad-undo="unblock_topic" data-ad-value="<%= topic.key %>">Allow again</button></li><% }) %>
        </ul>
        <% } %>
        <form class="mt-3 flex flex-wrap items-end gap-3" data-ad-topic-form>
          <div class="min-w-[14rem] flex-1"><label class="label" for="ad-topic-block">Turn off a topic</label><select class="input mt-1.5 w-full" id="ad-topic-block" name="topic"><% adTopicOptions.filter(function (option) { return !adPreferences.blockedTopics.some(function (topic) { return topic.key === option.key; }); }).forEach(function (option) { %><option value="<%= option.key %>"><%= option.label %></option><% }) %></select></div>
          <button class="btn-secondary" type="submit">Turn off</button>
        </form>
        <a class="mt-4 inline-flex items-center gap-1 text-15 font-semibold text-brand-600 hover:underline" href="/ads/manage">Run your own ads<svg class="icon size-4"><use href="#i-chevron-right"/></svg></a>
      </section>

      <section id="safety" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Account status</h2>
        <% const strikes = currentUser.strikes || 0; %>
        <p class="mt-1 text-15 text-muted"><%= strikes ? `Your account has ${strikes} ${strikes === 1 ? 'violation' : 'violations'} on record. Repeat violations can lead to a suspension.` : 'No violations on your account.' %></p>
        <% if (safetyCases.length) { %>
        <ul class="mt-4 space-y-3">
          <% safetyCases.forEach(function (item) { const appeal = (item.appeal || {}).status || 'none'; const restored = item.status === 'dismissed'; %>
          <li class="rounded-xl border border-line p-3">
            <p class="text-footnote text-muted"><%= item.targetType %> · <%= longTime(item.createdAt) %><%= item.categories.length ? ' · ' + item.categories.join(', ') : '' %></p>
            <% if (item.snippet) { %><p class="mt-1 line-clamp-3 whitespace-pre-wrap break-words text-15"><%= item.snippet %></p><% } %>
            <p class="mt-2 text-15 font-semibold"><%= restored ? 'Restored after review' : 'Removed' %></p>
            <% if (appeal === 'pending') { %><p class="mt-1 text-15 text-muted">Appeal sent. We will let you know the outcome.</p>
            <% } else if (appeal === 'denied') { %><p class="mt-1 text-15 text-muted">Your appeal was reviewed and the decision was kept.</p>
            <% } else if (appeal === 'none' && !restored) { %>
            <form class="mt-2 space-y-2" data-appeal-form="<%= item._id %>">
              <label class="label" for="appeal-<%= item._id %>">Think this was a mistake?</label>
              <textarea class="input w-full" id="appeal-<%= item._id %>" name="message" rows="2" minlength="10" maxlength="1000" required placeholder="Tell us why"></textarea>
              <p class="form-error hidden" data-form-error role="alert"></p>
              <button class="btn-secondary" type="submit">Appeal</button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </section>

      <section id="stories" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Stories</h2>
        <form class="mt-3 flex flex-wrap items-end gap-3" data-api-form data-method="PATCH" action="/api/stories/settings" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="min-w-[14rem] flex-1"><label class="label" for="story-audience-setting">Default story audience</label><select class="input mt-1.5 w-full" id="story-audience-setting" name="audience"><option value="followers" <%= info.storyAudience !== 'public' ? 'selected' : '' %>>Followers</option><option value="public" <%= info.storyAudience === 'public' ? 'selected' : '' %>>Public</option></select></div>
          <button class="btn-secondary" type="submit">Save</button>
          <p class="form-error hidden w-full" data-form-error role="alert"></p>
        </form>
        <a class="mt-3 inline-flex items-center gap-1 text-15 font-semibold text-brand-600 hover:underline" href="/stories/archive">Open story archive<svg class="icon size-4"><use href="#i-chevron-right"/></svg></a>
      </section>

      <section id="session" class="card scroll-mt-20 p-5">
        <h2 class="text-headline font-semibold">Session</h2>
        <p class="mt-1 text-15 text-muted">Log out of Oremus on this browser. Your other sessions stay active.</p>
        <button class="btn-secondary mt-4" type="button" data-logout><svg class="icon"><use href="#i-logout"/></svg>Log out</button>
      </section>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
