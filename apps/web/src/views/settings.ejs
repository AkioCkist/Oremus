<%- include('partials/head') %><%- include('partials/nav') %>
<% const info = currentUser.profile || {}; -%>
<main id="main" class="grid min-h-[calc(100dvh-3.5rem)] lg:grid-cols-[22.5rem_minmax(0,1fr)]">
  <aside class="border-b border-line bg-white lg:sticky lg:top-14 lg:h-[calc(100dvh-3.5rem)] lg:border-b-0 lg:border-r" aria-label="Settings sections">
    <div class="p-4">
      <h1 class="font-display text-2xl font-extrabold">Settings</h1>
      <nav class="mt-3 flex gap-1 overflow-x-auto lg:flex-col" aria-label="Settings">
        <a class="side-link shrink-0" href="#profile"><span class="icon-btn size-9"><svg class="icon"><use href="#i-user"/></svg></span>Profile</a>
        <a class="side-link shrink-0" href="#photos"><span class="icon-btn size-9"><svg class="icon"><use href="#i-camera"/></svg></span>Photos</a>
        <a class="side-link shrink-0" href="#privacy"><span class="icon-btn size-9"><svg class="icon"><use href="#i-shield"/></svg></span>Privacy</a>
        <a class="side-link shrink-0" href="#stories"><span class="icon-btn size-9"><svg class="icon"><use href="#i-stories"/></svg></span>Stories</a>
        <a class="side-link shrink-0" href="#session"><span class="icon-btn size-9"><svg class="icon"><use href="#i-key"/></svg></span>Session</a>
      </nav>
    </div>
  </aside>

  <section class="px-3 py-5 pb-24 sm:px-6">
    <div class="mx-auto max-w-2xl space-y-4">
      <form class="space-y-4" data-api-form data-method="PATCH" action="/api/profile" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <section id="profile" class="card scroll-mt-20 p-5">
          <h2 class="card-title text-xl">Profile</h2>
          <p class="text-15 text-muted">How people see you on Oremus.</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div><label class="label" for="displayName">Name</label><input class="input mt-1.5 w-full" id="displayName" name="displayName" value="<%= currentUser.displayName %>" required minlength="2" maxlength="60" autocomplete="name"></div>
            <div><label class="label" for="username">Username</label><input class="input mt-1.5 w-full" id="username" name="username" value="<%= currentUser.username %>" required pattern="[a-zA-Z0-9_]{3,24}" autocomplete="username" aria-describedby="username-help"><p id="username-help" class="helper">oremus.app/profile/<%= currentUser.username %></p></div>
          </div>
          <div class="mt-4"><label class="label" for="bio">Bio</label><textarea class="input mt-1.5 w-full" id="bio" name="bio" rows="3" maxlength="240" placeholder="Describe who you are"><%= info.bio || '' %></textarea></div>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div><label class="label" for="location">Current city</label><input class="input mt-1.5 w-full" id="location" name="location" maxlength="80" value="<%= info.location || '' %>" placeholder="e.g. Da Nang, Vietnam"></div>
            <div><label class="label" for="website">Website</label><input class="input mt-1.5 w-full" id="website" name="website" type="url" maxlength="200" value="<%= info.website || '' %>" placeholder="https://"></div>
          </div>
        </section>
        <section id="photos" class="card scroll-mt-20 p-5">
          <h2 class="card-title text-xl">Profile picture &amp; cover</h2>
          <div class="mt-4 grid gap-5 sm:grid-cols-[auto_1fr] sm:items-center">
            <%- include('partials/avatar', { person: currentUser, size: 'size-24 text-3xl' }) %>
            <div><label class="label" for="avatar">Profile picture</label><input class="file-input mt-1.5" id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></div>
          </div>
          <div class="mt-5">
            <label class="label" for="cover">Cover photo</label>
            <div class="mt-1.5 aspect-[16/5] overflow-hidden rounded-lg bg-field"><img class="size-full object-cover" src="<%= info.coverUrl || '/assets/img/default-cover.svg' %>" alt=""></div>
            <input class="file-input mt-2" id="cover" name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
          </div>
        </section>
        <section id="privacy" class="card scroll-mt-20 p-5">
          <h2 class="card-title text-xl">Privacy</h2>
          <label class="label mt-4 block" for="privacy-select">Who can see your profile details</label>
          <select class="input mt-1.5 w-full" id="privacy-select" name="privacy"><option value="public" <%= info.privacy !== 'followers' ? 'selected' : '' %>>Public — anyone on Oremus</option><option value="followers" <%= info.privacy === 'followers' ? 'selected' : '' %>>Followers only</option></select>
        </section>
        <div class="card sticky bottom-16 flex items-center justify-between gap-3 p-4 md:bottom-4">
          <p class="form-error hidden flex-1" data-form-error role="alert"></p>
          <span class="flex-1 text-[0.8125rem] text-muted">Changes apply to your profile right away.</span>
          <button class="btn-primary" type="submit">Save changes</button>
        </div>
      </form>

      <section id="stories" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Stories</h2>
        <form class="mt-3 flex flex-wrap items-end gap-3" data-api-form data-method="PATCH" action="/api/stories/settings" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="min-w-[14rem] flex-1"><label class="label" for="story-audience-setting">Default story audience</label><select class="input mt-1.5 w-full" id="story-audience-setting" name="audience"><option value="followers" <%= info.storyAudience !== 'public' ? 'selected' : '' %>>Followers</option><option value="public" <%= info.storyAudience === 'public' ? 'selected' : '' %>>Public</option></select></div>
          <button class="btn-secondary" type="submit">Save</button>
          <p class="form-error hidden w-full" data-form-error role="alert"></p>
        </form>
        <a class="mt-3 inline-flex items-center gap-1 text-15 font-semibold text-brand-600 hover:underline" href="/stories/archive">Open story archive<svg class="icon size-4"><use href="#i-chevron-right"/></svg></a>
      </section>

      <section id="session" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Session</h2>
        <p class="mt-1 text-15 text-muted">Log out of Oremus on this browser. Your other sessions stay active.</p>
        <button class="btn-secondary mt-4" type="button" data-logout><svg class="icon"><use href="#i-logout"/></svg>Log out</button>
      </section>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
