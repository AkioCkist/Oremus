<%- include('partials/head') %><%- include('partials/nav') %>
<% const info = currentUser.profile || {}; -%>
<main id="main" data-smooth-scroll class="grid min-h-[calc(100dvh-var(--header-h))] grid-cols-1 lg:grid-cols-[22.5rem_minmax(0,1fr)]">
  <aside class="border-b border-line bg-surface lg:sticky lg:top-[var(--header-h)] lg:h-[calc(100dvh-var(--header-h))] lg:border-b-0 lg:border-r" aria-label="Settings sections">
    <div class="p-4">
      <div class="flex items-center gap-3">
        <a href="/" class="header-action grid shrink-0 place-items-center rounded-full text-ink" aria-label="Back to home" title="Back to home"><svg class="icon"><use href="#i-chevron-left"/></svg></a>
        <h1 class="page-title">Settings</h1>
      </div>
      <nav class="mt-3 flex gap-1 overflow-x-auto lg:flex-col" aria-label="Settings">
        <a class="side-link shrink-0" href="#profile"><span class="tile-icon bg-ios-blue"><svg class="icon"><use href="#i-user"/></svg></span>Profile</a>
        <a class="side-link shrink-0" href="#photos"><span class="tile-icon bg-ios-orange"><svg class="icon"><use href="#i-camera"/></svg></span>Photos</a>
        <a class="side-link shrink-0" href="#privacy"><span class="tile-icon bg-subtle"><svg class="icon"><use href="#i-shield"/></svg></span>Privacy</a>
        <a class="side-link shrink-0" href="#display"><span class="tile-icon bg-ios-indigo"><svg class="icon"><use href="#i-moon"/></svg></span>Display</a>
        <a class="side-link shrink-0" href="#stories"><span class="tile-icon bg-ios-pink"><svg class="icon"><use href="#i-stories"/></svg></span>Stories</a>
        <a class="side-link shrink-0" href="#session"><span class="tile-icon bg-ios-teal"><svg class="icon"><use href="#i-key"/></svg></span>Session</a>
      </nav>
    </div>
  </aside>

  <section class="bg-grouped px-3 py-5 pb-24 sm:px-6 lg:py-10">
    <div class="mx-auto max-w-2xl space-y-4">
      <section id="profile" class="card scroll-mt-20 overflow-hidden">
        <div class="relative aspect-[16/5] bg-field"><img class="size-full object-cover" src="<%= info.coverUrl || '/assets/img/default-cover.svg' %>" alt=""><button type="button" class="btn absolute bottom-3 right-3 bg-surface text-ink shadow-card hover:bg-hover" data-pick-photo-kind="cover"><svg class="icon"><use href="#i-camera"/></svg><span class="hidden sm:inline">Edit cover photo</span></button></div>
        <div class="flex flex-wrap items-end gap-4 px-5 pb-5">
          <div class="relative -mt-10"><%- include('partials/avatar', { person: currentUser, size: 'size-24 text-3xl ring-4 ring-surface' }) %><button type="button" class="icon-btn absolute -bottom-1 -right-1 size-9" data-pick-photo-kind="avatar" aria-label="Update profile picture"><svg class="icon size-[1.125rem]"><use href="#i-camera"/></svg></button></div>
          <div class="min-w-0 flex-1"><h2 class="truncate text-xl font-bold"><%= currentUser.displayName %></h2><p class="truncate text-15 text-muted">@<%= currentUser.username %><%= info.location ? ' · ' + info.location : '' %></p></div>
          <div class="flex gap-2"><button type="button" class="btn-primary" data-open-dialog="edit-profile-dialog"><svg class="icon"><use href="#i-edit"/></svg>Edit profile</button><a class="btn-secondary" href="/profile/<%= currentUser.username %>">View profile</a></div>
        </div>
      </section>
      <section id="photos" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Photos</h2>
        <p class="mt-1 text-15 text-muted">Pick from your uploads and previous photos, or upload a new one.</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          <button type="button" class="flex items-center gap-3 rounded-lg p-2 text-left hover:bg-hover" data-pick-photo-kind="avatar"><span class="icon-btn"><svg class="icon"><use href="#i-user"/></svg></span><span><span class="block font-semibold">Profile picture</span><span class="block text-[0.8125rem] text-muted">Choose or upload</span></span></button>
          <button type="button" class="flex items-center gap-3 rounded-lg p-2 text-left hover:bg-hover" data-pick-photo-kind="cover"><span class="icon-btn"><svg class="icon"><use href="#i-image"/></svg></span><span><span class="block font-semibold">Cover photo</span><span class="block text-[0.8125rem] text-muted">Choose or upload</span></span></button>
        </div>
      </section>
      <section id="privacy" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Privacy</h2>
        <form class="mt-3 flex flex-wrap items-end gap-3" data-api-form data-method="PATCH" action="/api/profile/details" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="min-w-[14rem] flex-1"><label class="label" for="privacy-select">Who can see your profile details</label><select class="input mt-1.5 w-full" id="privacy-select" name="privacy"><option value="public" <%= info.privacy !== 'followers' ? 'selected' : '' %>>Public — anyone on Oremus</option><option value="followers" <%= info.privacy === 'followers' ? 'selected' : '' %>>Followers only</option></select></div>
          <button class="btn-secondary" type="submit">Save</button>
          <p class="form-error hidden w-full" data-form-error role="alert"></p>
        </form>
      </section>

      <section id="display" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Display</h2>
        <p class="mt-1 text-15 text-muted">Adjust the appearance of Oremus to reduce glare and give your eyes a break.</p>
        <fieldset class="mt-4 space-y-2">
          <legend class="label mb-2">Dark mode</legend>
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
            <span class="icon-btn shrink-0"><svg class="icon"><use href="#i-sun"/></svg></span>
            <span class="flex-1"><span class="block font-semibold">Off</span><span class="block text-[0.8125rem] text-muted">Bright background with dark text.</span></span>
            <input type="radio" name="theme" value="light" class="check size-5" data-theme-choice <%= theme === 'light' ? 'checked' : '' %>>
          </label>
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
            <span class="icon-btn shrink-0"><svg class="icon"><use href="#i-moon"/></svg></span>
            <span class="flex-1"><span class="block font-semibold">On</span><span class="block text-[0.8125rem] text-muted">Dark background that is easier on the eyes at night.</span></span>
            <input type="radio" name="theme" value="dark" class="check size-5" data-theme-choice <%= theme === 'dark' ? 'checked' : '' %>>
          </label>
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
            <span class="icon-btn shrink-0"><svg class="icon"><use href="#i-monitor"/></svg></span>
            <span class="flex-1"><span class="block font-semibold">Automatic</span><span class="block text-[0.8125rem] text-muted">Match your device's display settings.</span></span>
            <input type="radio" name="theme" value="system" class="check size-5" data-theme-choice <%= theme === 'system' ? 'checked' : '' %>>
          </label>
        </fieldset>
        <p class="mt-3 text-[0.8125rem] text-muted">Saved on this device. You can also switch quickly from the account menu.</p>
      </section>

      <section id="stories" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Stories</h2>
        <form class="mt-3 flex flex-wrap items-end gap-3" data-api-form data-method="PATCH" action="/api/stories/settings" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="min-w-[14rem] flex-1"><label class="label" for="story-audience-setting">Default story audience</label><select class="input mt-1.5 w-full" id="story-audience-setting" name="audience"><option value="followers" <%= info.storyAudience !== 'public' ? 'selected' : '' %>>Followers</option><option value="public" <%= info.storyAudience === 'public' ? 'selected' : '' %>>Public</option></select></div>
          <button class="btn-secondary" type="submit">Save</button>
          <p class="form-error hidden w-full" data-form-error role="alert"></p>
        </form>
        <a class="mt-3 inline-flex items-center gap-1 text-15 font-semibold text-brand-600 hover:underline" href="/stories/archive">Open story archive<svg class="icon size-4"><use href="#i-chevron-right"/></svg></a>
      </section>

      <section id="session" class="card scroll-mt-20 p-5">
        <h2 class="card-title text-xl">Session</h2>
        <p class="mt-1 text-15 text-muted">Log out of Oremus on this browser. Your other sessions stay active.</p>
        <button class="btn-secondary mt-4" type="button" data-logout><svg class="icon"><use href="#i-logout"/></svg>Log out</button>
      </section>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
