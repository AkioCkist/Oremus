<%- include('partials/head') %><%- include('partials/nav') %><main id="main" class="mx-auto max-w-3xl px-4 py-8 pb-24"><div class="flex items-center justify-between"><div><p class="eyebrow">Activity</p><h1 class="mt-2 text-3xl font-bold">Notifications</h1></div><button class="button-secondary" data-read-notifications>Mark all read</button></div><section class="card mt-6 overflow-hidden"><% if (notifications.length) { %><ul class="divide-y divide-stone-100"><% notifications.forEach(function(notification) { %><li class="flex gap-3 p-4 <%= notification.readAt ? '' : 'bg-accent-50' %>"><span class="avatar size-10"><%= notification.actorId.displayName.charAt(0) %></span><div><p><strong><%= notification.actorId.displayName %></strong> <%= notification.text %></p><p class="mt-1 text-sm text-stone-500"><%= new Date(notification.createdAt).toLocaleString() %></p></div></li><% }) %></ul><% } else { %><div class="empty-state border-0"><h2 class="font-semibold">You are all caught up</h2><p class="mt-2 text-stone-600">New reactions, comments, follows, and messages will appear here.</p><a class="button-primary mt-5 inline-flex" href="/">Return to feed</a></div><% } %></section></main><%- include('partials/foot') %>

