<%- include('partials/head') %><%- include('partials/nav') %>

<main id="main" class="app-shell">
  <section class="mx-auto w-full max-w-feed">
    <div class="overflow-hidden">
      <div class="page-header flex items-end justify-between gap-3 !pb-0">
        <h1 class="page-title">Notifications</h1>
        <button class="btn-ghost text-brand-600" type="button" data-read-notifications><svg class="icon"><use href="#i-check"/></svg>Mark all as read</button>
      </div>
      <nav class="flex gap-2 px-4 py-3" aria-label="Filter notifications">
        <a class="chip <%= filter === 'all' ? 'chip-active' : '' %>" href="/notifications" <%= filter === 'all' ? 'aria-current=page' : '' %>>All</a>
        <a class="chip <%= filter === 'unread' ? 'chip-active' : '' %>" href="/notifications?filter=unread" <%= filter === 'unread' ? 'aria-current=page' : '' %>>Unread</a>
      </nav>
      <%# The list is always rendered so notifications that arrive live have somewhere to go. %>
      <ul class="px-2 pb-2" data-infinite="notifications" data-infinite-next="<%= next || '' %>" data-infinite-query="filter=<%= filter %>&opened=<%= openedAt.getTime() %>">
        <%- include('partials/chunks/notifications', { items }) %>
      </ul>
      <div class="<%= items.length ? 'hidden' : '' %> px-6 pb-10 pt-6 text-center" data-notifications-empty><div class="empty-icon"><svg class="icon size-7"><use href="#i-bell"/></svg></div><h2 class="mt-4 text-lg font-bold"><%= filter === 'unread' ? 'No unread notifications' : "You're all caught up" %></h2><p class="mt-1 text-pretty text-muted">Friend requests, reactions, comments and messages will show up here.</p><a class="btn-primary mt-5" href="/">Back to feed</a></div>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
