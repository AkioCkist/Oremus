<%- include('partials/head') %><%- include('partials/nav') %>
<% const roots = comments.filter(function (c) { return !c.parentId; }); const repliesOf = function (id) { return comments.filter(function (c) { return String(c.parentId) === String(id); }); }; -%>
<main id="main" class="mx-auto max-w-feed space-y-4 px-0 py-4 pb-24 sm:px-4">
  <a class="btn-ghost ml-2 sm:ml-0" href="/"><svg class="icon"><use href="#i-arrow-left"/></svg>Back to feed</a>
  <%- include('partials/post-card', { item: post, hideViewAll: true }) %>
  <section id="comments" class="card p-4" aria-labelledby="comments-title">
    <div class="flex items-center justify-between"><h2 id="comments-title" class="card-title">Comments</h2><span class="text-sm text-muted" data-comments-total><%= plural(comments.length, 'comment') %></span></div>
    <% if (comments.length) { %>
    <ul class="mt-4 space-y-3">
      <% roots.forEach(function (comment) { %>
      <li>
        <%- include('partials/comment', { comment, postId: post._id, isReply: false, canModerate }) %>
        <% const replies = repliesOf(comment._id); if (replies.length) { %>
        <ul class="ml-12 mt-2 space-y-2 border-l-2 border-line pl-3">
          <% replies.forEach(function (reply) { %><li><%- include('partials/comment', { comment: reply, postId: post._id, isReply: true, canModerate }) %></li><% }) %>
        </ul>
        <% } %>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <div class="py-8 text-center"><div class="empty-icon"><svg class="icon size-7"><use href="#i-comment"/></svg></div><p class="mt-3 font-semibold">No comments yet</p><p class="text-sm text-muted">Be the first to comment.</p></div>
    <% } %>
    <% if (!currentUser) { %><p class="mt-4 text-center text-15"><a class="font-semibold text-brand-600 hover:underline" href="/login">Log in</a> to join the conversation.</p><% } %>
  </section>
</main>
<%- include('partials/foot') %>
