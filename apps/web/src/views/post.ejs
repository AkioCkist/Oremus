<%- include('partials/head') %><%- include('partials/nav') %>
<main id="main" class="mx-auto max-w-2xl space-y-5 px-4 py-6 pb-24"><a class="text-sm font-semibold text-accent-700" href="/">← Back to feed</a><%- include('partials/post-card', { item: post }) %><section id="comments" class="card p-4"><h2 class="text-lg font-semibold">Conversation</h2>
  <% if (currentUser) { %><form class="mt-4 flex gap-3" data-api-form data-reset data-reload action="/api/posts/<%= post._id %>/comments" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="comment">Write a comment</label><textarea id="comment" class="input min-h-12 flex-1" name="content" required maxlength="1500" placeholder="Add to the conversation"></textarea><button class="button-primary self-end" type="submit">Comment</button><p class="form-error hidden" data-form-error role="alert"></p></form><% } %>
  <% if (comments.length) { %><ul class="mt-6 space-y-5"><% comments.forEach(function(comment) { %><li class="flex gap-3 <%= comment.parentId ? 'ml-8 border-l border-stone-200 pl-4' : '' %>"><a class="avatar size-9" href="/profile/<%= comment.authorId.username %>"><%= comment.authorId.displayName.charAt(0) %></a><div class="min-w-0 flex-1"><p><a class="font-semibold hover:underline" href="/profile/<%= comment.authorId.username %>"><%= comment.authorId.displayName %></a> <span class="text-xs text-stone-500"><%= new Date(comment.createdAt).toLocaleString() %></span></p><p class="mt-1 whitespace-pre-wrap text-pretty"><%= comment.content %></p><% if (currentUser) { %><button class="mt-1 text-sm font-semibold text-accent-700" data-toggle="reply-<%= comment._id %>">Reply</button><form id="reply-<%= comment._id %>" class="mt-2 hidden space-y-2" data-api-form data-reset data-reload action="/api/posts/<%= post._id %>/comments" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="parentId" value="<%= comment._id %>"><label class="sr-only" for="reply-input-<%= comment._id %>">Reply to <%= comment.authorId.displayName %></label><textarea class="input min-h-16 w-full" id="reply-input-<%= comment._id %>" name="content" maxlength="1500" required placeholder="Write a reply"></textarea><p class="form-error hidden" data-form-error role="alert"></p><button class="button-primary px-3 py-1.5 text-sm" type="submit">Post reply</button></form><% } %></div></li><% }) %></ul><% } else { %><p class="mt-5 text-sm text-stone-500">No comments yet. Start the conversation.</p><% } %>
</section></main><%- include('partials/foot') %>
